[run]
source = lathe
branch = True
omit =
    lathe/scaffolds/*
    lathe/__init__.py

[report]
# Ratchet gate: prevents regression below the current measured baseline.
# Plan 04's 85% target is tracked as BL-39 for a future Wave 5 test-backfill stage.
fail_under = 65
show_missing = True
skip_covered = False
precision = 2
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if TYPE_CHECKING:
    if __name__ == .__main__.:

[html]
directory = htmlcov

[xml]
output = coverage.xml
