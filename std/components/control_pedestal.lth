// doc:
//   purpose: component definitions for the control_pedestal family (body, bezel, screen, control panel, column, base, hatch, socket).
//   exports: components pedestal_body_shell, pedestal_bezel_frame, pedestal_screen_panel, pedestal_control_panel, pedestal_column, pedestal_base_plate, pedestal_service_hatch, pedestal_socket_plate
//   depends_on: none (authored material zones from std.materials.hero_materials)
//   used_by: std.families.control_pedestal (transitively examples/control_pedestal.lth)
//   stability: stable
//   layer: V1.0
module std.components.control_pedestal

component pedestal_body_shell {
  part = body
  tags = [body, shell, pedestal]
  material_zone = painted_steel_body
  geometry {
    component_type = shell
  }
}

component pedestal_bezel_frame {
  part = bezel_frame
  tags = [bezel, frame]
  material_zone = rubber_trim_dark
  geometry {
    component_type = bezel
  }
}

component pedestal_screen_panel {
  part = screen_panel
  tags = [screen, panel]
  material_zone = smoked_glass_screen
  geometry {
    component_type = panel
  }
}

component pedestal_control_panel {
  part = control_panel
  tags = [panel, console]
  material_zone = painted_steel_body
  geometry {
    component_type = panel
  }
}

component pedestal_column {
  part = pedestal_column
  tags = [stand, column]
  interface_role = support
  material_zone = painted_steel_body
  geometry {
    component_type = stand
  }
}

component pedestal_base_plate {
  part = base_plate
  tags = [plate, base]
  interface_role = support
  material_zone = painted_steel_body
  geometry {
    component_type = panel
  }
}

component pedestal_service_hatch {
  part = service_hatch
  tags = [door, hatch]
  material_zone = warning_paint
  geometry {
    component_type = door
  }
}

component pedestal_socket_plate {
  part = socket_plate
  tags = [socket, plate]
  material_zone = rubber_trim_dark
  geometry {
    component_type = socket_plate
  }
}
