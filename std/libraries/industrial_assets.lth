// doc:
//   purpose: V1.1 library aggregating industrial hard-surface families, components, materials, and patterns for environment authoring.
//   exports: library industrial_hardsurface_library
//   depends_on: std.families.{sci_fi_wall_panel, console_terminal, mechanical_door}, std.components.{sci_fi_wall_panel, console_terminal}, std.materials.hero_materials, std.patterns.hero_patterns (referenced by name)
//   used_by: examples/service_corridor_wall.lth
//   stability: beta
//   layer: V1.1
module std.libraries.industrial_assets

library industrial_hardsurface_library {
  families = [
    sci_fi_wall_panel_family,
    console_terminal_family,
    mechanical_door_family,
  ]
  components = [
    wall_panel_shell,
    wall_screen_bezel,
    wall_frame_panel,
    wall_vent_l,
    wall_vent_r,
    console_body_shell,
    console_bezel,
    console_screen,
    console_panel_face,
    console_stand,
  ]
  materials = [
    painted_steel_body,
    smoked_glass_screen,
    rubber_trim_dark,
  ]
  patterns = [
    vent_slats_dense,
    cargo_fastener_grid,
  ]
}
