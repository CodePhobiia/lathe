module std.surface_programs.hero_surface_programs

surface_program chest_wood_brass_hero {
  workflow = pbr_metal_rough
  maps = [basecolor, normal, orm, ao, curvature, id]
  bakes = [ao, curvature, id]
  decals = [crest, trim_wear]
  patterns = [plank_spacing_hero, rivet_row_hero]
  zones.body = oak_body
  zones.lid = oak_body
  zones.panel = oak_body
  zones.lock = aged_brass_trim
  zones.handle = aged_brass_trim
  zones.foot = aged_brass_trim
  zones.hinge = aged_brass_trim
  zones.clasp = aged_brass_trim
  zones.liner = velvet_interior
}

