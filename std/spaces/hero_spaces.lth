module std.spaces.hero_spaces

space chest_hero_search {
  vary feature_density in 0.95..1.28
  vary panel_depth in 0.90..1.24
  vary edge_weight in 0.92..1.22
  freeze silhouette_bias
  objective maximize silhouette_readability weight 0.25
  objective maximize geometry_integration_quality weight 0.30
  objective maximize visual_surface_quality weight 0.20
  objective minimize primitive_likeness_penalty weight 0.25
  select best_of 10
}

space drone_hero_search {
  vary feature_density in 0.94..1.24
  vary support_spread in 0.94..1.16
  vary rotor_guard_scale in 0.96..1.18
  vary edge_weight in 0.92..1.18
  freeze silhouette_bias
  objective maximize silhouette_readability weight 0.20
  objective maximize geometry_integration_quality weight 0.35
  objective maximize visual_surface_quality weight 0.20
  objective minimize primitive_likeness_penalty weight 0.25
  select best_of 12
}

