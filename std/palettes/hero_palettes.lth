// doc:
//   purpose: named material palettes that bind material sets to hero families (fantasy, courier, industrial, door, crate).
//   exports: palettes fantasy_brassbound, courier_premium, industrial_service_console, industrial_crate_hero_palette, mechanical_door_hero_palette
//   depends_on: std.materials.hero_materials
//   used_by: all std.families.* hero families (transitively every hero example)
//   stability: stable
//   layer: V0.8
module std.palettes.hero_palettes
import std.materials.hero_materials

palette fantasy_brassbound {
  materials = [oak_body, aged_brass_trim, velvet_interior]
}

palette courier_premium {
  materials = [anodized_aluminum_body, carbon_fiber_trim, amber_glass_lens]
}

palette industrial_service_console {
  materials = [painted_steel_body, smoked_glass_screen, rubber_trim_dark]
}

palette industrial_crate_hero_palette {
  materials = [painted_steel_body, rubber_trim_dark, warning_paint]
}

palette mechanical_door_hero_palette {
  materials = [painted_steel_body, seal_rubber, smoked_glass_screen]
}
