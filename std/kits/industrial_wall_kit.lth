// doc:
//   purpose: V1.1 kit binding the sci_fi_wall_panel family into a snap-grid modular wall kit with allowed join rules.
//   exports: kit industrial_wall_kit
//   depends_on: std.families.sci_fi_wall_panel, std.components.sci_fi_wall_panel (referenced by module name)
//   used_by: examples/service_corridor_wall.lth
//   stability: beta
//   layer: V1.1
module std.kits.industrial_wall_kit

kit industrial_wall_kit {
  family = sci_fi_wall_panel_family
  modules = [
    wall_panel_shell,
    wall_screen_bezel,
    wall_frame_panel,
    wall_vent_l,
    wall_vent_r,
    wall_mount_top,
    wall_mount_bottom,
  ]
  snap_grid = 10cm
  clearance = 1cm
  allowed_joins = [panel_to_panel, panel_to_frame, panel_to_vent]
}
