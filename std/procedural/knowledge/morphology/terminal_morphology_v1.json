{
  "id": "terminal_morphology_v1",
  "description": "Interactive terminal / kiosk / control panel morphology. Pedestal body with tilted face holding screen + buttons + ports.",
  "domain": "hard_surface",
  "body": {
    "archetype": "pedestal",
    "long_axis": "Z",
    "expected_aspect": {
      "x": [0.4, 0.7],
      "y": [0.3, 0.6],
      "z": [0.9, 1.0]
    }
  },
  "parts_ladder": [
    {"role": "primary_pedestal", "required": true, "min_count": 1, "max_count": 1, "node_type": "primary_volume"},
    {"role": "screen_face", "required": true, "min_count": 1, "max_count": 1, "node_type": "panel"},
    {"role": "button_panel", "required": false, "min_count": 0, "max_count": 3, "node_type": "panel"},
    {"role": "port_set", "required": false, "min_count": 0, "max_count": 6, "node_type": "socket"},
    {"role": "base_mount", "required": false, "min_count": 0, "max_count": 1, "node_type": "mount"},
    {"role": "primary_material", "required": true, "min_count": 1, "max_count": 1, "node_type": "material_zone"}
  ],
  "anchor_emitters": [
    {"role": "front_face_upper", "selector": "front_face", "height_range_m": [0.9, 1.4]},
    {"role": "front_face_lower", "selector": "front_face", "height_range_m": [0.5, 0.9]},
    {"role": "side_face", "selector": "side_faces"},
    {"role": "base", "selector": "bottom_face"}
  ],
  "default_relations": [
    {"source_role": "screen_face", "relation": "inset_into", "target_role": "front_face_upper"},
    {"source_role": "button_panel", "relation": "inset_into", "target_role": "front_face_lower"},
    {"source_role": "port_set", "relation": "inset_into", "target_role": "side_face"},
    {"source_role": "base_mount", "relation": "attached_to", "target_role": "base"}
  ]
}
