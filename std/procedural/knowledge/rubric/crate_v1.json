{
  "id": "crate_v1",
  "asset_class": "crate",
  "description": "Class-anchor rubric for crate/container/shipping-prop assets. Checks bounded volume + reinforcement + lid seam + material separation + scale plausibility.",
  "minimum_pass_fraction": 0.65,
  "checks": [
    {
      "evidence_key": "bounded_volume_present",
      "check_kind": "synthesized_role_present",
      "parameters": {"role": "primary_volume"},
      "severity": "required",
      "repair_action": "add_secondary_features"
    },
    {
      "evidence_key": "corner_reinforcement_present",
      "check_kind": "synthesized_role_present",
      "parameters": {"role": "bracket"},
      "severity": "required",
      "repair_action": "add_secondary_features"
    },
    {
      "evidence_key": "lid_seam_or_trim_present",
      "check_kind": "synthesized_role_present",
      "parameters": {"role": "trim"},
      "severity": "required",
      "repair_action": "add_secondary_features"
    },
    {
      "evidence_key": "panel_breakup_present",
      "check_kind": "synthesized_role_present",
      "parameters": {"role": "panel"},
      "severity": "required",
      "repair_action": "increase_panel_depth"
    },
    {
      "evidence_key": "handles_or_latch_present",
      "check_kind": "synthesized_role_present",
      "parameters": {"role": "handle"},
      "severity": "soft"
    },
    {
      "evidence_key": "material_separation",
      "check_kind": "material_zone_count_at_least",
      "parameters": {"min": 1},
      "severity": "required",
      "repair_action": "add_secondary_features"
    },
    {
      "evidence_key": "scale_plausibility_crate",
      "check_kind": "bounding_volume_in_range",
      "parameters": {
        "x_range_cm": [20.0, 250.0],
        "y_range_cm": [20.0, 250.0],
        "z_range_cm": [15.0, 200.0]
      },
      "severity": "required"
    },
    {
      "evidence_key": "non_trivial_silhouette",
      "check_kind": "mesh_extents_exceed_intent",
      "parameters": {"threshold_cm": 1.0},
      "severity": "required",
      "repair_action": "add_secondary_features"
    },
    {
      "evidence_key": "face_count_sufficient",
      "check_kind": "face_count_at_least",
      "parameters": {"min": 5000},
      "severity": "soft"
    }
  ]
}
