// doc:
//   purpose: hard-surface family for the console_terminal hero prop (industrial service console).
//   exports: family console_terminal_family
//   depends_on: std.components.console_terminal, std.mechanisms.hero_mechanisms, std.palettes.hero_palettes, std.patterns.hero_patterns, std.surface_programs.hero_surface_programs, std.repair.hero_hardsurface, std.spaces.hero_spaces
//   used_by: examples/console_terminal.lth, examples/console_terminal_v12_surface.lth, examples/console_terminal_mobile_adapt.lth
//   stability: stable
//   layer: V1.0
module std.families.console_terminal
import std.components.console_terminal
import std.mechanisms.hero_mechanisms
import std.palettes.hero_palettes
import std.patterns.hero_patterns
import std.surface_programs.hero_surface_programs
import std.repair.hero_hardsurface
import std.spaces.hero_spaces

family console_terminal_family: hard_surface_prop {
  runtime_family = console_terminal
  blueprint_id = lathe.blueprint.hard_surface_console_terminal_v2

  geometry {
    mode = exact_hard_surface
    seam_classes = [bezel_break, service_panel, base_split]
    edge_classes = [hero_bevel, screen_bevel, support_bevel]
    integration_rules = [boolean_union, preserve_screen_bezel]
  }

  features {
    allow = [screen_bezel, vent_grille, trim_band, support_bracket, edge_break]
    density = hero
  }

  surface {
    program = console_terminal_hero
    patterns = [vent_slats_dense, cargo_fastener_grid]
    palette = industrial_service_console
    materials = [painted_steel_body, smoked_glass_screen, rubber_trim_dark]
    material_zones = [painted_steel_body, smoked_glass_screen, rubber_trim_dark]
    decals = [service_labels, screen_glow]
    bake = [normal, ao, curvature, id]
  }

  assembly {
    components = [console_body_shell, console_bezel, console_screen, console_panel_face, vent_left, vent_right, console_stand, power_socket_plate]
    mechanisms = [console_service_panel_mechanism]
  }

  search {
    use = console_hero_search
  }

  repair_policy {
    use = hero_hardsurface_repair
  }
}
