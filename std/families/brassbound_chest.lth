module std.families.brassbound_chest
import std.components.brassbound_chest
import std.mechanisms.hero_mechanisms
import std.palettes.hero_palettes
import std.patterns.hero_patterns
import std.surface_programs.hero_surface_programs
import std.repair.hero_hardsurface
import std.spaces.hero_spaces

family brassbound_chest_family: hard_surface_prop {
  runtime_family = brassbound_chest
  blueprint_id = lathe.blueprint.hard_surface_chest_v2

  geometry {
    mode = exact_hard_surface
    seam_classes = [panel_seam, lid_break, clasp_cut]
    edge_classes = [hero_bevel, support_bevel, trim_edge]
    integration_rules = [boolean_union, preserve_lid_break]
  }

  features {
    allow = [inset_panel, frame_lip, trim_band, clasp_set, recessed_handle, support_bracket, edge_break]
    density = hero
  }

  surface {
    program = chest_wood_brass_hero
    patterns = [plank_spacing_hero, rivet_row_hero]
    palette = fantasy_brassbound
    materials = [oak_body, aged_brass_trim, velvet_interior]
    material_zones = [oak_body, aged_brass_trim, velvet_interior]
    decals = [crest, trim_wear]
    bake = [normal, ao, curvature, id]
  }

  assembly {
    components = [chest_body, chest_lid, brass_latch_set, front_clasp, side_handle_l, side_handle_r, support_foot_l, support_foot_r, chest_interior_liner]
    mechanisms = [lid_hinge_mechanism]
  }

  search {
    use = chest_hero_search
  }

  repair_policy {
    use = hero_hardsurface_repair
  }
}
