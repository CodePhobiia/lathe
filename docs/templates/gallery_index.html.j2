<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Lathe gallery — $asset_name</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
         max-width: 1100px; margin: 2rem auto; padding: 0 1rem; color: #222; }
  h1 { margin-bottom: 0.25rem; }
  .meta { color: #555; margin-bottom: 1.5rem; }
  .certified-yes { color: #1a7f37; font-weight: 600; }
  .certified-no { color: #cf222e; font-weight: 600; }
  .renders { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
             gap: 0.75rem; margin-top: 1rem; }
  .renders img { width: 100%; height: auto; border: 1px solid #d0d7de; border-radius: 4px; }
  .placeholder { padding: 1rem; border: 1px dashed #d0d7de; border-radius: 4px;
                 color: #777; margin-top: 1rem; }
  code { background: #f6f8fa; padding: 0.1rem 0.3rem; border-radius: 3px; }
</style>
</head>
<body>
<h1>$asset_name</h1>
<div class="meta">
  <div>Score: <code>$score</code> &mdash; threshold: <code>$threshold</code>
       &mdash; <span class="certified-$certified_class">$certified</span></div>
  <div>GLB: <code>$glb_path</code></div>
</div>
$renders_block
<p><a href="../index.html">&larr; back to gallery</a></p>
</body>
</html>
