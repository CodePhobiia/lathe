{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.procedural/schemas/kit_graph.v1.json",
  "title": "KitGraph",
  "description": "World/scene composition: visual_language + material palette + texel density + archetypes + variation.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "archetypes"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "visual_language_id": {"type": "string"},
    "material_palette_id": {"type": "string"},
    "texel_density_px_per_m": {"type": "number", "minimum": 1},
    "variation_seed": {"type": "integer"},
    "archetypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "source_lth"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "source_lth": {"type": "string", "minLength": 1},
          "asset_name": {"type": "string"},
          "seed_strategy": {"type": "string", "enum": ["stratified", "uniform", "fixed"]},
          "repetition_limit": {"type": "integer", "minimum": 1},
          "condition_distribution": {
            "type": "array",
            "items": {"type": "number", "minimum": 0, "maximum": 1},
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    }
  }
}
