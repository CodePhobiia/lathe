{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.procedural/schemas/morphology_profile.v1.json",
  "title": "MorphologyProfile",
  "description": "Typed morphology pack: body archetype + parts ladder + anchor emitters + default relations.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "body", "parts_ladder"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "domain": {"type": "string", "minLength": 1},
    "body": {
      "type": "object",
      "required": ["archetype"],
      "properties": {
        "archetype": {"type": "string", "minLength": 1},
        "long_axis": {"type": "string", "enum": ["X", "Y", "Z", "X_or_Y"]},
        "expected_aspect": {
          "type": "object",
          "properties": {
            "x": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
            "y": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
            "z": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
          }
        }
      }
    },
    "parts_ladder": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "min_count": {"type": "integer", "minimum": 0},
          "max_count": {"type": "integer", "minimum": 0},
          "node_type": {"type": "string"}
        }
      }
    },
    "anchor_emitters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "selector": {"type": "string"},
          "side_candidates": {"type": "array", "items": {"type": "string"}},
          "height_range_m": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
        }
      }
    },
    "default_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_role", "relation", "target_role"],
        "properties": {
          "source_role": {"type": "string", "minLength": 1},
          "relation": {"type": "string", "minLength": 1},
          "target_role": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
