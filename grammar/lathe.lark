?start: program

program: module_decl? import_decl* decl*

module_decl: "module" qident
import_decl: "import" qident

?decl: profile_decl
     | contract_decl
     | critic_decl
     | library_decl
     | kit_decl
     | pattern_decl
     | family_decl
     | component_decl
     | assembly_decl
     | trait_decl
     | mechanism_decl
     | material_decl
     | surface_program_decl
     | surface_backend_decl
     | surface_policy_decl
     | decal_library_decl
     | mask_program_decl
     | trim_sheet_decl
     | palette_decl
     | style_pack_decl
     | style_bridge_decl
     | faction_pack_decl
     | biome_kit_decl
     | architecture_grammar_decl
     | object_grammar_decl
     | vegetation_species_decl
     | vegetation_kit_decl
     | wind_program_decl
     | volume_program_decl
     | wfc_tileset_decl
     | wfc_adjacency_decl
     | terrain_program_decl
     | subdivision_finishing_decl
     | f_rep_program_decl
     | reference_set_decl
     | reconstruct_policy_decl
     | adapt_policy_decl
     | assembly_policy_decl
     | fit_profile_decl
     | transfer_rule_decl
     | execution_profile_decl
     | render_fixture_decl
     | bake_profile_decl
     | library_binding_decl
     | material_graph_decl
     | inspection_policy_decl
     | asset_class_profile_decl
     | repair_policy_decl
     | fixture_decl
     | test_decl
     | benchmark_decl
     | space_decl
     | world_decl
     | scene_decl
     | asset_decl
     | variant_decl

use_clause: "uses" qident ("," qident)*

profile_decl: "profile" IDENT use_clause? "{" defaults_block? rule_stmt* repair_block? "}"
contract_decl: "contract" IDENT use_clause? "{" defaults_block? rule_stmt* repair_block? "}"

critic_decl: "critic" IDENT "(" IDENT ":" "asset" ")" "=" critic_body
?critic_body: weighted_critic | expr
weighted_critic: "weighted" "{" weighted_item+ "}"
weighted_item: metric_ref number

family_decl: "family" IDENT (":" kind)? use_clause? "{" family_item* "}"
?family_item: defaults_block
            | params_block
            | geometry_block
            | features_block
            | source_surface_block
            | assembly_block
            | space_inline_block
            | search_inline_block
            | repair_policy_inline_block
            | rule_stmt
            | assign_stmt

component_decl: "component" IDENT use_clause? "{" component_item* "}"
?component_item: params_block
               | geometry_block
               | features_block
               | source_surface_block
               | assembly_block
               | assign_stmt

assembly_decl: "assembly" IDENT use_clause? "{" assembly_decl_item* "}"
?assembly_decl_item: params_block
                   | geometry_block
                   | features_block
                   | assembly_block
                   | assign_stmt

trait_decl: "trait" IDENT use_clause? "{" trait_item* "}"
?trait_item: defaults_block
           | geometry_block
           | features_block
           | source_surface_block
           | assembly_block
           | repair_policy_inline_block
           | rule_stmt
           | assign_stmt

mechanism_decl: "mechanism" IDENT version_clause? use_clause? "{" mechanism_item* "}"
?mechanism_item: params_block
               | geometry_block
               | assembly_block
               | ports_block
               | parameters_block
               | body_block
               | assign_stmt

library_decl: "library" IDENT version_clause? use_clause? "{" library_item* "}"
?library_item: ports_block
             | parameters_block
             | body_block
             | assign_stmt
kit_decl: "kit" IDENT version_clause? use_clause? "{" kit_item* "}"
?kit_item: ports_block
         | parameters_block
         | body_block
         | assign_stmt

version_clause: "version" STRING

ports_block: "ports" "{" port_decl* "}"
port_decl: port_dir IDENT ":" IDENT port_decl_options?
port_dir: "in"  -> port_in
        | "out" -> port_out
port_decl_options: "{" assign_stmt* "}"

parameters_block: "parameters" "{" parameter_decl* "}"
parameter_decl: IDENT ":" IDENT parameter_decl_options?
parameter_decl_options: "{" assign_stmt* "}"

body_block: "body" "{" body_item* "}"
?body_item: kit_use_stmt
          | rule_stmt
          | assign_stmt
kit_use_stmt: "use" "kit" qident version_constraint_clause? kit_use_bindings?
version_constraint_clause: "version" STRING
kit_use_bindings: "{" assign_stmt* "}"
pattern_decl: "pattern" IDENT use_clause? "{" assign_stmt* "}"
material_decl: "material" IDENT use_clause? "{" assign_stmt* "}"
surface_program_decl: "surface_program" IDENT use_clause? "{" assign_stmt* "}"
surface_backend_decl: "surface_backend" IDENT use_clause? "{" assign_stmt* "}"
surface_policy_decl: "surface_policy" IDENT use_clause? "{" assign_stmt* "}"
decal_library_decl: "decal_library" IDENT use_clause? "{" assign_stmt* "}"
mask_program_decl: "mask_program" IDENT use_clause? "{" assign_stmt* "}"
trim_sheet_decl: "trim_sheet" IDENT use_clause? "{" assign_stmt* "}"
palette_decl: "palette" IDENT use_clause? "{" assign_stmt* "}"
style_pack_decl: "style_pack" IDENT "{" assign_stmt* "}"
style_bridge_decl: "style_bridge" IDENT "{" assign_stmt* "}"
faction_pack_decl: "faction_pack" IDENT use_clause? "{" assign_stmt* "}"
biome_kit_decl: "biome_kit" IDENT use_clause? "{" assign_stmt* "}"
architecture_grammar_decl: "architecture_grammar" IDENT use_clause? "{" assign_stmt* "}"
object_grammar_decl: "object_grammar" IDENT use_clause? "{" assign_stmt* "}"
vegetation_species_decl: "vegetation_species" IDENT version_clause? use_clause? "{" assign_stmt* "}"
vegetation_kit_decl: "vegetation_kit" IDENT version_clause? use_clause? "{" assign_stmt* "}"
wind_program_decl: "wind_program" IDENT use_clause? "{" assign_stmt* "}"
volume_program_decl: "volume_program" IDENT use_clause? "{" assign_stmt* "}"
wfc_tileset_decl: "wfc_tileset" IDENT version_clause? use_clause? "{" assign_stmt* "}"
wfc_adjacency_decl: "wfc_adjacency" IDENT use_clause? "{" assign_stmt* "}"
terrain_program_decl: "terrain_program" IDENT use_clause? "{" assign_stmt* "}"
// Roadmap §7.6: F-Rep / SDF authoring program. Body bindings compose
// IQ-style SDF primitives, booleans, and modifiers into an evaluable
// expression tree consumed by :mod:`lathe.f_rep`.
f_rep_program_decl: "f_rep_program" IDENT use_clause? "{" assign_stmt* "}"
// V1.3.2 (roadmap §7.5): top-level subdivision finishing pass declaration.
// Sibling assigns describe the cage/scheme/levels/creases payload that the
// :class:`SubdivisionFinishingSpec` resolver in :mod:`lathe.subdivision`
// consumes; assets reference the decl through
// ``build.topology.subdivision_finishing = "<name>"``.
subdivision_finishing_decl: "subdivision_finishing" IDENT use_clause? "{" assign_stmt* "}"
reference_set_decl: "reference_set" IDENT use_clause? "{" assign_stmt* "}"
reconstruct_policy_decl: "reconstruct_policy" IDENT use_clause? "{" assign_stmt* "}"
adapt_policy_decl: "adapt_policy" IDENT use_clause? "{" assign_stmt* "}"
assembly_policy_decl: "assembly_policy" IDENT use_clause? "{" assign_stmt* "}"
fit_profile_decl: "fit_profile" IDENT use_clause? "{" assign_stmt* "}"
transfer_rule_decl: "transfer_rule" IDENT use_clause? "{" assign_stmt* "}"
execution_profile_decl: "execution_profile" IDENT use_clause? "{" assign_stmt* "}"
render_fixture_decl: "render_fixture" IDENT use_clause? "{" assign_stmt* "}"
bake_profile_decl: "bake_profile" IDENT use_clause? "{" assign_stmt* "}"
library_binding_decl: "library_binding" IDENT use_clause? "{" assign_stmt* "}"
material_graph_decl: "material_graph" IDENT use_clause? "{" assign_stmt* "}"
inspection_policy_decl: "inspection_policy" IDENT use_clause? "{" assign_stmt* "}"
asset_class_profile_decl: "asset_class_profile" IDENT use_clause? "{" assign_stmt* "}"
repair_policy_decl: "repair_policy" IDENT "{" assign_stmt* "}"
fixture_decl: "fixture" IDENT "{" assign_stmt* "}"
test_decl: "test" IDENT "{" assign_stmt* assert_stmt* "}"
benchmark_decl: "benchmark" IDENT "{" assign_stmt* assert_stmt* "}"
space_decl: "space" IDENT "{" space_stmt* "}"

world_decl: "world" IDENT "{" scene_item* "}"
