from_clause: "from" qident
asset_decl: "asset" IDENT ":" kind from_clause? use_clause? "{" refs_block? intent_block? geometry_block? features_block? source_surface_block? assembly_block? fit_block? transfer_block? reuse_block? constraints_block? ingest_block? assembly_rules_block? execution_block? space_inline_block? search_inline_block? repair_policy_inline_block? build_block? validate_block? package_block? publish_block? experimental_block? "}"

// Phase 13: experimental syntax (additive, gated under `experimental { ... }`).
// All new sub-blocks live INSIDE this wrapper. Without this wrapper, none of
// the experimental constructs parse. The stable public surface is unchanged.
experimental_block: "experimental" "{" experimental_entry* "}"
?experimental_entry: experimental_art_direction_block | experimental_references_block | experimental_kit_block | experimental_unknown_subblock
experimental_art_direction_block: "art_direction" "{" assign_stmt* "}"
experimental_references_block: "references" "{" assign_stmt* "}"
experimental_kit_block: "kit" "{" assign_stmt* "}"
experimental_unknown_subblock: IDENT "{" assign_stmt* "}"
variant_decl: "variant" IDENT "on" qident "{" patch_stmt+ "}"

kind: KIND
KIND: "hard_surface_prop" | "env_module" | "mechanical_assembly"

defaults_block: "defaults" "{" assign_stmt* "}"
repair_block: "repair" "{" assign_stmt* "}"
params_block: "params" "{" assign_stmt* "}"

refs_block: "refs" "{" assign_stmt* "}"
intent_block: "intent" "{" assign_stmt* "}"
geometry_block: "geometry" "{" assign_stmt* "}"
features_block: "features" "{" assign_stmt* "}"
source_surface_block: "surface" "{" assign_stmt* "}"
assembly_block: "assembly" "{" assign_stmt* "}"
fit_block: "fit" "{" assign_stmt* "}"
transfer_block: "transfer" "{" assign_stmt* "}"
reuse_block: "reuse" "{" assign_stmt* "}"
constraints_block: "constraints" "{" assign_stmt* "}"
ingest_block: "ingest" "{" assign_stmt* "}"
// V1.1 form: `assembly_rules { repeat_modules = [...]; inserts = [...]; ... }`
// CGA-style form (additive, V1.3.1+): a `productions = [ "Lot --> ..." ]`
// list of CGA production strings, parsed by `lathe/cga/`. Optional sibling
// keys: `root = Lot`, `seed = 0`, `recursion_budget = 32`.
assembly_rules_block: "assembly_rules" "{" assign_stmt* "}"
space_inline_block: "space" "{" space_stmt* "}"
search_inline_block: "search" "{" space_stmt* "}"
repair_policy_inline_block: "repair_policy" "{" assign_stmt* "}"
execution_block: "execution" "{" assign_stmt* "}"

build_block: "build" "{" shape_block? topology_block? uv_block? build_surface_block? rig_block? interfaces_block? physics_block? optimize_block? "}"
// V1.4 §5.1: ``shape{}`` may host an optional ``mesh_program{}`` block that
// declares an ordered procedural script (``let`` bindings + side-effecting
// op calls) lowered to ``ShapePrimitive`` records before the shape stage
// runs. The block sits alongside (not instead of) the existing assignment
// fields like ``mode = generate``, ``candidates = N``, etc.
shape_block: "shape" "{" assign_stmt* mesh_program_block? assign_stmt* "}"
// Ordered statement-style sub-block. Statements run top-to-bottom and may
// reference identifiers introduced by earlier ``let`` statements.
mesh_program_block: "mesh_program" "{" mesh_stmt* "}"
?mesh_stmt: mesh_let_stmt | mesh_call_stmt
mesh_let_stmt: "let" IDENT "=" mesh_expr
mesh_call_stmt: mesh_expr
// A ``mesh_expr`` is either a bare call (``box(...)``), an identifier
// reference, or a chained method call (``ident.translate((..))``). Mesh
// calls accept normal expression arguments plus nested mesh expressions
// so fluent cutters such as ``body.subtract(other: box(...).translate(...))``
// remain a single executable construction chain.
mesh_expr: mesh_atom mesh_method_suffix*                -> mesh_chain_expr
mesh_chained_arg: mesh_atom mesh_method_suffix+          -> mesh_chain_expr
mesh_method_suffix: "." IDENT "(" [mesh_args] ")"
?mesh_atom: IDENT "(" [mesh_args] ")"                   -> mesh_call_expr
          | IDENT                                  -> mesh_ident_expr
mesh_args: mesh_arg ("," mesh_arg)*
?mesh_arg: IDENT ":" mesh_arg_value                 -> named_arg
         | mesh_arg_value                           -> positional_arg
?mesh_arg_value: SIGNED_AXIS                        -> signed_axis_lit
               | mesh_list
               | mesh_chained_arg
               | expr
mesh_list: "[" [mesh_arg_value ("," mesh_arg_value)* ","?] "]"
topology_block: "topology" "{" assign_stmt* "}"
uv_block: "uv" "{" assign_stmt* "}"
build_surface_block: "surface" "{" assign_stmt* "}"
rig_block: "rig" "{" assign_stmt* "}"
interfaces_block: "interfaces" "{" assign_stmt* "}"
physics_block: "physics" "{" assign_stmt* "}"
optimize_block: "optimize" "{" assign_stmt* "}"

validate_block: "validate" "{" rule_stmt* assign_stmt* repair_block? "}"
package_block: "package" "{" assign_stmt* "}"
publish_block: "publish" "{" assign_stmt* "}"

rule_stmt: "ensure" expr                         -> ensure_rule
         | "prefer" expr ("weight" number)?     -> prefer_rule

space_stmt: "vary" path "in" expr                             -> vary_stmt
          | "freeze" path                                     -> freeze_stmt
          | "objective" objective_dir metric_ref ("weight" number)? -> objective_stmt
          | "select" "best_of" number                         -> select_best_of_stmt
          | assign_stmt

objective_dir: "maximize" -> maximize_dir
             | "minimize" -> minimize_dir

assert_stmt: "assert" expr

assign_stmt: path "=" expr

patch_stmt: "set" path "=" expr      -> set_patch
          | "append" path "=" expr   -> append_patch
          | "remove" path "=" expr   -> remove_patch
          | "unset" path              -> unset_patch

?metric_ref: call | qident

?expr: or_expr

?or_expr: and_expr
        | or_expr "or" and_expr       -> or_expr

?and_expr: equality
         | and_expr "and" equality    -> and_expr

?equality: comparison
         | equality "==" comparison   -> eq_expr
         | equality "!=" comparison   -> neq_expr

?comparison: sum
           | comparison "<" sum       -> lt_expr
           | comparison "<=" sum      -> lte_expr
           | comparison ">" sum       -> gt_expr
           | comparison ">=" sum      -> gte_expr
           | comparison "in" sum      -> in_expr

?sum: term
    | sum "+" term                    -> add_expr
    | sum "-" term                    -> sub_expr

?term: factor
     | term "*" factor                -> mul_expr
     | term "/" factor                -> div_expr

?factor: "not" factor                -> not_expr
       | "-" factor                   -> neg_expr
       | range_expr

?range_expr: atom ".." atom          -> range_expr
           | atom

?atom: literal
     | qident                         -> ident_expr
     | list
     | call
     | "(" expr ")"

list: "[" [expr ("," expr)* ","?] "]"
call: qident "(" [args] ")"
args: arg ("," arg)*
?arg: IDENT ":" expr                 -> named_arg
    | expr                            -> positional_arg

path: IDENT ("." IDENT)*
qident: IDENT ("." IDENT)*

?literal: UNIT_LITERAL                -> unit_lit
        | number                      -> number_lit
        | STRING                      -> string_lit
        | "true"                     -> true_lit
        | "false"                    -> false_lit

number: NUMBER

IDENT: /[a-z][a-z0-9_]*/
STRING: /"(?:\\.|[^"\\])*"/
SIGNED_AXIS.2: /[+-][xyz]\b/
UNIT_LITERAL.2: /-?(?:\d+\.\d+|\d+)(?:mm|cm|m|deg|rad|g|kg|ms|s|kb|mb|gb|px|px_per_m|px_per_cm)\b/
NUMBER: /-?(?:\d+\.\d+|\d+)/

COMMENT_LINE: /\/\/[^\n]*/
COMMENT_BLOCK: /\/\*[\s\S]*?\*\//

%import common.WS
%ignore WS
%ignore COMMENT_LINE
%ignore COMMENT_BLOCK
