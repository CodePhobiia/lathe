# Lathe environment variables.
#
# Copy to `.env` and edit. The values below are examples, not defaults —
# unset values fall through to runtime-config defaults (see
# `lathe/runtime_config.py`).
#
# The 13 vars below are the ACTUAL ones read by `apply_env_overrides` in
# `lathe/runtime_config.py:107-172`. They are the authoritative set and
# must match that file exactly — a CI drift test (Plan 05 Phase 2 item
# #7b) enforces this.

# --- Shape stage (probabilistic) --------------------------------------
LATHE_SHAPE_PROVIDER=                # override `shape.provider` id (e.g. lathe.provider.shape.reference_conditioned_v1)
LATHE_SHAPE_STRICT=                  # 1/true/yes/on → force `shape.strict`; disables silent fallback
LATHE_HUNYUAN_BASE_URL=              # base URL for hunyuan2_1_http provider
LATHE_VGGT_WEIGHTS=                  # absolute path to VGGT weights file
LATHE_VGGT_DEVICE=                   # torch device for VGGT (cpu|cuda|cuda:0|...)

# --- Topology stage (Blender adapter) ---------------------------------
LATHE_TOPOLOGY_ADAPTER=              # override `topology.adapter` id
LATHE_TOPOLOGY_STRICT=               # 1/true/yes/on → force `topology.strict`
LATHE_BLENDER_PATH=                  # absolute path to the `blender` binary (sets both topology + execution)

# --- UV stage (xatlas adapter) ----------------------------------------
LATHE_UV_ADAPTER=                    # override `uv.adapter` id
LATHE_UV_STRICT=                     # 1/true/yes/on → force `uv.strict`
LATHE_XATLAS_RESOLUTION=             # integer; xatlas target atlas resolution

# --- Surface stage ----------------------------------------------------
LATHE_CODEX_IMAGEGEN=                # mode for `surface.codex_imagegen` backend

# --- Execution stage --------------------------------------------------
LATHE_EXECUTION_BLENDER_STRICT=      # 1/true/yes/on → force execution.blender.strict


# ======================================================================
# Planned — NOT YET IMPLEMENTED
# ----------------------------------------------------------------------
# The variables below are scoped for future phases. They are listed
# here so early adopters can see the roadmap, but they are not read by
# `lathe/runtime_config.py` yet. Do NOT rely on them.
# ======================================================================

LATHE_CACHE_DIR=~/.cache/lathe        # Plan 05 Phase 9b — grammar/parser cache root; not yet wired
LATHE_LOG_LEVEL=info                  # Plan 05 Phase 9b — logging verbosity; not yet wired
LATHE_SEED=                           # Plan 05 Phase 9b — reproducibility seed; not yet wired
LATHE_ALLOW_EXTERNAL_OUT=0            # Plan 07 Phase 2 — allow --out paths outside repo; not yet wired
LATHE_BLENDER_ROOTS=                  # Plan 07 Phase 2 — path allowlist for blender subprocesses; not yet wired
