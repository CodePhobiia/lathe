module examples.geometry_wave1.panelized_service_crate

asset geometry_wave1_panelized_service_crate: hard_surface_prop {
  intent {
    role = "panelized service crate"
    style = ["industrial", "modular", "wave1_geometry"]
    parts = [body, lid, latch_plate, handle_l, handle_r, foot_l, foot_r]
    materials = [painted_steel, dark_rubber, warning_paint]
    scale = 0.9m
  }

  features {
    density = hero
    allow = [panel_seam, layer_plate, corner_guard, bolt_grid, edge_break]
  }

  build {
    shape {
      mode = generate
      candidates = 2
      seed = 101
      symmetry = x
      detail_density = hero
      edge_complexity = high
      edge_treatment = beveled
      panelization = hero
      greeble_density = high
      surface_layer_count = 3
      detail_zones = [body, lid]
    }
    rig { type = none joints = [] }
    interfaces {}
  }

  validate { threshold = 0.80 }
  package { formats = [glb] }
}
