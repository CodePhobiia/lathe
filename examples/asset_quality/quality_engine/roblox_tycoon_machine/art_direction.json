      "service panel scale",
      "button/readout scale"
    ]
  },
  "schema_version": "lathe.asset_quality.art_direction.v1",
  "silhouette": {
    "forbidden_shapes": [
      "unclear interaction affordance",
      "tiny unreadable controls",
      "photoreal grime",
      "overdense microdetail"
    ],
    "required_distinctive_features": [
      "readable dropper body",
      "conveyor output",
      "large upgrade button",
      "status display",
      "service panel"
    ],
    "target_strength": "high",
    "thumbnail_size_px": 128
  },
  "style_intent": {
    "audience": "roblox_runtime_proxy",
    "genre": "roblox",
    "mood": [
      "roblox",
      "tycoon",
      "bright",
      "playful",
      "runtime-safe"
    ],
    "quality_bar": "phase14c_universal_quality_warning",
    "substyle": "bright Roblox tycoon machine with clear interactive affordances"
  },
  "surface_story": {
    "decals": [
      "status labels",
      "direction arrows",
      "interaction icons"
    ],
    "grime_logic": [
      "recesses",
      "lower contact points",
      "handled/touched affordances"
    ],
    "wear_logic": [
      "button touch wear",
      "output port grime",
      "convex edge wear",
      "contact polish",
      "recess grime"
    ]
  },
  "visual_hierarchy": {
    "noise_policy": "ornament must map to a declared motif, material transition, or functional affordance",
    "primary_read": "machine identity through readable dropper body",
    "secondary_read": "functional parts and silhouette accents remain readable",
    "tertiary_read": "ornament, decals, wear, and microdetail are bounded by motif or function"
  }
