{
  "asset_id": "quality_engine_roblox_tycoon_machine",
  "forbidden_failure_modes": [
    "material zones without semantic purpose",
    "overdense microdetail",
    "photoreal grime",
    "random primitive stack",
    "style mismatch between parts",
    "tiny unreadable controls",
    "unbounded procedural noise",
    "unclear interaction affordance",
    "weak thumbnail read"
  ],
  "materials": {
    "contrast_policy": "primary/secondary/accent/readability",
    "required_separation": "high",
    "zones": [
      "primary material",
      "secondary support material",
      "accent/focal material",
      "wear overlay",
      "signal or emissive material"
    ]
  },
  "motifs": {
    "allowed": [
      "roblox",
      "tycoon",
      "bright",
      "playful",
      "signal strips",
      "ports",
      "service panels"
    ],
    "forbidden": [
      "unclear interaction affordance",
      "tiny unreadable controls",
      "photoreal grime",
      "overdense microdetail"
    ],
    "placement_rules": [
      "place motifs around input/output affordances and service access"
    ]
  },
  "object_family": "machine",
  "platform": {
    "target": "roblox_runtime_proxy",
    "texture_policy": "deterministic_pbr_proxy",
    "triangle_budget_strict": 3500,
    "triangle_budget_warning": 5000
  },
  "proportion_policy": {
    "exaggeration_allowed_when_style_requires": true,
    "functional_scale_required": true,
    "scale_anchors": [
