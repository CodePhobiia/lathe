module studio.props.controls
import std.families.control_pedestal

profile control_station_prop {
  defaults {
    build.optimize.lods = 4
    package.formats = [usd, glb]
    package.manifest = true
    package.include_trace = true
  }

  ensure units(cm)
  ensure manifold
  ensure watertight
  ensure material_slots(max: 4)
  ensure uv_range(set: base, range: 0..1)
  ensure lightmap_uvs
  ensure collision_proxy
}

contract shipping_terminal uses control_station_prop {
  defaults {
    build.interfaces.clearance = 2cm
  }

  ensure pivots(policy: studio_standard)
  ensure names(policy: studio_standard)
  ensure texel_density(target: 512px_per_m, tolerance: 0.10)
  ensure runtime_budget(draw_calls: 3, texture_memory: 24mb)

  prefer silhouette_readability weight 0.3
  prefer part_coherence weight 0.2
}

critic pedestal_prop(a: asset) = weighted {
  prompt_match 0.24
  silhouette_readability 0.16
  topology_quality 0.20
  material_quality 0.16
  runtime_efficiency 0.10
  part_coherence 0.14
}

asset control_pedestal: hard_surface_prop from control_pedestal_family uses shipping_terminal {
  intent {
    role = "industrial control pedestal"
    style = ["industrial", "control_station", "sci_fi"]
    parts = [
      body,
      bezel_frame,
      screen_panel,
      control_panel,
      pedestal_column,
      base_plate,
      service_hatch,
      socket_plate,
    ]
    materials = [painted_steel_body, smoked_glass_screen, rubber_trim_dark]
    negatives = ["ornate", "organic", "soft"]
    scale = 1.55m
    interactions = [read_display, press_controls, place_in_world]
  }

  geometry {
    mode = exact_hard_surface
    seam_classes = [bezel_break, service_hatch, base_split]
    edge_classes = [hero_bevel, screen_bevel, support_bevel]
    integration_rules = [boolean_union, preserve_screen_bezel, preserve_pedestal_column]
  }

  features {
    density = hero
    allow = [screen_bezel, vent_grille, trim_band, support_bracket, edge_break, fastener_strip]
  }

  surface {
    program = control_pedestal_hero
    patterns = [vent_slats_dense, cargo_fastener_grid]
    palette = industrial_service_console
    material_zones = [painted_steel_body, smoked_glass_screen, rubber_trim_dark]
    materials = [painted_steel_body, smoked_glass_screen, rubber_trim_dark]
    decals = [service_labels, screen_glow]
    bake = [normal, ao, curvature, id]
  }

  assembly {
    components = [pedestal_body_shell, pedestal_bezel_frame, pedestal_screen_panel, pedestal_control_panel, pedestal_column, pedestal_base_plate, pedestal_service_hatch, pedestal_socket_plate]
    mechanisms = [console_service_panel_mechanism]
  }

  search {
    use = pedestal_hero_search
  }

  repair_policy {
    use = hero_hardsurface_repair
  }

  build {
    shape {
      mode = generate
      candidates = 4
      seed = 71
      symmetry = x
      preserve = [silhouette, part_graph, symmetry, proportions]
    }

    topology {
      retopo = auto
      target_quads = 13000
      ngons = forbid
      preserve = [hard_edges, part_borders]
    }

    uv {
      sets = [base, lightmap]
      unwrap = auto
      padding = 8px
      texel_density = 512px_per_m
    }

    surface {
      workflow = pbr_metal_rough
      maps = [basecolor, normal, orm, emissive]
      resolution = 2048px
      bakes = [ao, curvature, id]
      decals = [service_labels, screen_glow]
      id_map = true
    }

    rig {
      type = none
      joints = []
      pivot_policy = studio_standard
      joint_limits = auto
    }

    interfaces {
      sockets = [socket(id: power_socket, socket_type: port)]
      pivots = [pivot(id: floor_contact, pivot_type: contact)]
      clearance = 2cm
    }

    physics {
      collision = convex_decomp
      max_hulls = 6
      mass = auto
      center_of_mass = auto
    }

    optimize {
      lods = 4
      atlas = true
      draw_calls = 2
      texture_budget = 24mb
      mesh_compression = true
    }
  }

  validate {
    score = pedestal_prop
    threshold = 0.83

    repair {
      mode = auto_until_pass
      max_rounds = 4
      allow = [
        reselect_candidate,
        enforce_symmetry,
        seal_mesh,
        retopo_auto,
        reduce_tris,
        repack_uvs,
        rebake_maps,
        reauthor_surface_layer,
        normalize_pivots,
        create_collision_proxy,
        generate_lods,
      ]
      deny = [rebuild_shape]
    }
  }

  package {
    formats = [usd, glb]
    previews = [turntable, wireframe, material_ids, uv_layout, collision, lod_sheet]
    embed_textures = false
  }
}

test control_pedestal_language_surface {
  asset = control_pedestal
  assert from == control_pedestal_family
  assert surface.program == control_pedestal_hero
  assert space.use == pedestal_hero_search
}

benchmark control_pedestal_hero_language {
  asset = control_pedestal
  must_pass = true
  assert score >= threshold
}
