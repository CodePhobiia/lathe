module wonder.generated.alchemist_observatory

scene alchemist_observatory {
  version = 1
  brief = alchemist_observatory
  prompt = "A forgotten alchemist observatory inside the ribcage of a dead god."

  style scene_style {
    mood = [sacred, eerie, antique]
    palette = ["bone ivory", "oxidized copper", "black glass", "candle gold", "lunar blue"]
    materials = ["bone stone", "oxidized brass", "obsidian glass", "cracked enamel", wax]
    forms = ["ribbed arches", "circular instruments", "thin spires", "constellation engraving"]
    lighting = ["cold moonbeam", "warm candle clusters", "subtle dust haze"]
    avoid = ["modern electronics", "clean sci-fi panels"]
  }

  region region_central_chamber: interior {
    name = "Central Chamber"
    purpose = "Main reveal space for the observatory."
    mood = "sacred and abandoned"
    bounds.center = [0, 0, 2.2]
    bounds.size = [12, 8, 4.4]
    semantic_tags = [observatory, ritual, "bone architecture"]
  }

  region region_entry_threshold: threshold {
    name = "Entry Threshold"
    purpose = "Approach path that frames the central table."
    mood = "quiet and dust-filled"
    bounds.center = [0, -4.2, 1.5]
    bounds.size = [3, 1.4, 3]
    semantic_tags = [entry, framing]
  }

  region region_sealed_archive: threshold {
    name = "Sealed Archive Door"
    purpose = "Unopened expansion hook behind the observatory."
    mood = "forbidden and quiet"
    bounds.center = [4.8, 1.5, 1.7]
    bounds.size = [1.6, 1, 3.4]
    semantic_tags = [sealed, archive, expansion]
  }

  object obj_astrolabe_table_001: hero_prop from astrolabe_table {
    name = "Central Astrolabe Table"
    region = region_central_chamber
    source_family = ornate_mechanical_table
    transform.position = [0, 0, 0.75]
    transform.rotation = [0, 0, 0]
    transform.scale = [1.4, 1.4, 1]
    material_bindings.metal = mat_oxidized_brass
    material_bindings.lens = mat_black_glass
    semantic_tags = [astronomy, ritual, interactive]
    gameplay {
      affordances.inspect_lens.action = inspect
      affordances.inspect_lens.reveals = hidden_warm_lens_truth
    }
    state.damaged = false
    state.powered = true
    state.secret_compartment = unopened
  }

  object obj_rib_arches_001: architecture from rib_arch_ring {
    name = "Rib Arch Ring"
    region = region_central_chamber
    source_kit = bone_architecture
    transform.position = [0, 0, 2]
    transform.rotation = [0, 0, 0]
    transform.scale = [1, 1, 1]
    material_bindings.bone = mat_bone_ivory
    semantic_tags = [ribcage, architecture, shelter]
    state.cracked = true
    state.load_bearing = true
  }

  object obj_candle_cluster_001: light_fixture from candle_cluster {
    name = "Candle Cluster"
    region = region_central_chamber
    source_family = ritual_candles
    variant = melted
    transform.position = [-2.2, 1.6, 0.25]
    transform.rotation = [0, 0, 18]
    transform.scale = [0.8, 0.8, 0.8]
    material_bindings.wax = mat_candle_wax
    material_bindings.flame = mat_candle_gold
    semantic_tags = [ritual, "warm light", "scale cue"]
    state.lit = true
    state.wax_drip_amount = 0.8
  }

  object obj_archive_door_001: interactive from sealed_archive_door {
    name = "Sealed Archive Door"
    region = region_sealed_archive
    source_family = mechanical_door
    transform.position = [4.8, 1.5, 1.7]
    transform.rotation = [0, 0, -90]
    transform.scale = [1, 1, 1]
    material_bindings.frame = mat_oxidized_brass
    material_bindings.panel = mat_bone_ivory
    semantic_tags = [sealed, archive, mystery]
    gameplay {
      affordances.attempt_open.action = open
      affordances.attempt_open.requires = star_lens_alignment
    }
    state.locked = true
    state.requires = star_lens_alignment
  }

  relationship rel_lens_points_to_archive: points_toward {
    from = obj_astrolabe_table_001
    to = obj_archive_door_001
    description = "The table alignment suggests the archive door is part of the same mechanism."
  }

  relationship rel_moon_lights_table: lit_by {
    from = light_moonbeam_001
    to = obj_astrolabe_table_001
    description = "The moonbeam highlights the warm black lens."
  }

  relationship rel_ribs_contain_chamber: contains {
    from = obj_rib_arches_001
    to = region_central_chamber
    description = "The rib ring defines the primary chamber boundary."
  }

  lighting_plan light_moonbeam_001: moonbeam {
    target = obj_astrolabe_table_001
    color = "lunar blue"
    intensity = 0.82
    purpose = "Cold key light across the hero table."
  }

  lighting_plan light_candle_cluster_001: candle_cluster {
    target = obj_candle_cluster_001
    color = "candle gold"
    intensity = 0.36
    purpose = "Warm practical fill near the floor."
  }

  camera_intent camera_reveal: cinematic_wide {
    target = obj_astrolabe_table_001
    purpose = "First impression of chamber scale, rib architecture, and focal object."
    transform.position = [-5.2, -5.6, 2.4]
    transform.rotation = [66, 0, -40]
    transform.scale = [1, 1, 1]
    fov_degrees = 48
  }

  camera_intent camera_warm_lens_detail: inspection {
    target = obj_astrolabe_table_001
    purpose = "Read the warm lens and engraved constellations."
    transform.position = [-1.8, -1.4, 1.4]
    transform.rotation = [62, 0, -36]
    transform.scale = [1, 1, 1]
    fov_degrees = 36
  }

  curiosity_anchor curiosity_warm_lens {
    attached_to = obj_astrolabe_table_001
    visible_clue = "The black glass lens glows faintly even though the room is abandoned."
    hidden_fact = "The lens is still tracking a living star."
    suggested_user_actions = ["inspect lens", "align astrolabe", "open star map"]
    expansion_options.hidden_star_map.label = "Generate the hidden star map revealed by the warm lens."
    expansion_options.hidden_star_map.target_scope = obj_astrolabe_table_001
    expansion_options.hidden_star_map.required_assets = [etched_star_map, projected_constellation_lines]
    expansion_options.hidden_star_map.continuity_constraints = ["preserve central chamber layout", "preserve table position"]
    expansion_options.opened_archive.label = "Open the sealed archive door and reveal the next region."
    expansion_options.opened_archive.target_scope = region_sealed_archive
    expansion_options.opened_archive.required_assets = [archive_room_shell, bone_shelf_kit]
    expansion_options.opened_archive.continuity_constraints = ["preserve archive door identity", "preserve moonbeam direction"]
  }

  curiosity_anchor curiosity_sealed_archive {
    attached_to = obj_archive_door_001
    visible_clue = "The sealed archive door has a star-shaped key socket that matches the astrolabe lens."
    hidden_fact = "The archive door opens only when the lens finishes aligning with the living star."
    suggested_user_actions = ["inspect door", "align lens", "open archive"]
    expansion_options.forbidden_archive.label = "Open the archive and generate the forbidden room beyond the threshold."
    expansion_options.forbidden_archive.target_scope = region_sealed_archive
    expansion_options.forbidden_archive.required_assets = [archive_room_shell, bone_shelf_kit, sealed_star_charts]
    expansion_options.forbidden_archive.continuity_constraints = ["preserve archive door identity", "preserve central chamber layout", "preserve living star lore"]
  }

  hidden_state hidden_warm_lens_truth {
    attached_to = obj_astrolabe_table_001
    fact = "The lens remains warm because it is linked to a living star beyond the dead god's ribs."
    reveal_condition = "User inspects the lens or aligns the astrolabe."
    visible = false
  }

  hidden_state hidden_archive_door_truth {
    attached_to = obj_archive_door_001
    fact = "The archive door opens only when the lens finishes aligning with the living star."
    reveal_condition = "User aligns the astrolabe lens and inspects the archive door."
    visible = false
  }

  export scene_graph {
    format = json
    path = "scene_graph.json"
  }

  export scene_package {
    format = lathepkg
    path = "dist/alchemist_observatory.lathepkg"
  }

  export glb {
    format = glb
    path = "dist/exports/alchemist_observatory.glb"
  }

  // JSON-only v1 data is preserved below, including object provenance, export
  // metadata, material definitions, build artifacts, and memory.
  // Embedded payload summary: layout=1, materials=5, build_artifacts=2, memory_events=2.
}

