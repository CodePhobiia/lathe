  relationship rel_stdlib_wall_supports_shell: supports {
    from = obj_architecture_wall_001
    to = obj_architecture_room_shell_001
    description = "Wall modules are the primary boundary pieces for room shells."
  }

  relationship rel_stdlib_moon_window_lights_altar: lit_by {
    from = obj_light_moon_window_001
    to = obj_hero_altar_001
    description = "Lighting fixtures can be linked to hero props for reveal composition."
  }

  lighting_plan light_stdlib_key: area {
    target = obj_hero_altar_001
    color = "soft emissive"
    intensity = 0.8
    purpose = "Readable catalog key light."
  }

  camera_intent camera_reveal: cinematic_wide {
    target = obj_hero_altar_001
    purpose = "Reveal the standard-library component gallery."
    transform.position = [-10.0, -10.0, 5.0]
    transform.rotation = [60.0, 0.0, -35.0]
    transform.scale = [1.0, 1.0, 1.0]
    fov_degrees = 55.0
  }

  curiosity_anchor curiosity_stdlib_wall_index {
    attached_to = obj_architecture_wall_001
    visible_clue = "The wall index labels which modules can grow into larger room shells."
    hidden_fact = "The kit wall index marks which modules can expand into a larger room shell."
    suggested_user_actions = ["inspect wall index", "expand room shell"]
    expansion_options.expand_room_shell.label = "Generate a larger modular room shell."
    expansion_options.expand_room_shell.target_scope = region_stdlib_gallery
    expansion_options.expand_room_shell.required_assets = [architecture_wall, architecture_floor, architecture_ceiling]
    expansion_options.expand_room_shell.continuity_constraints = ["preserve component ids"]
  }

  curiosity_anchor curiosity_stdlib_light_modes {
    attached_to = obj_light_moon_window_001
    visible_clue = "The moon window and torch sit side by side with distinct light colors."
    hidden_fact = "The moon window and torch entries demonstrate alternate lighting fixtures for mood changes."
    suggested_user_actions = ["inspect lighting modes", "switch mood"]
    expansion_options.switch_catalog_mood.label = "Show the same component set under a darker lighting plan."
    expansion_options.switch_catalog_mood.target_scope = obj_light_moon_window_001
    expansion_options.switch_catalog_mood.required_assets = [light_moon_window, light_torch]
    expansion_options.switch_catalog_mood.continuity_constraints = ["preserve object layout"]
  }

  hidden_state hidden_stdlib_wall_index {
    attached_to = obj_architecture_wall_001
    fact = "The kit wall index marks which modules can expand into a larger room shell."
    reveal_condition = "User inspects the wall index labels."
    visible = false
  }

  hidden_state hidden_stdlib_light_modes {
    attached_to = obj_light_moon_window_001
    fact = "The moon window and torch entries demonstrate alternate lighting fixtures for mood changes."
    reveal_condition = "User inspects the lighting fixture row."
    visible = false
  }

  export scene_graph {
    format = json
    path = "exports/stdlib_component_showcase.scene_graph.json"
  }

