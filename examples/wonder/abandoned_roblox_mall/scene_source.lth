module wonder.generated.abandoned_roblox_mall

scene abandoned_roblox_mall {
  version = 1
  brief = abandoned_roblox_mall
  prompt = "An abandoned Roblox-ready low-poly mall atrium with shuttered storefronts, a dry fountain planter, a broken escalator, and one glowing security gate hinting at a hidden arcade."

  style scene_style {
    mood = [quiet, dusty, playable]
    palette = ["faded teal", "sun-worn coral", "dust gray", "soft yellow"]
    materials = ["painted concrete", "scuffed tile", "simple glass", "plastic signage"]
    forms = ["blocky storefronts", "rounded planter bowl", "chunky railings", "simple neon strips"]
    lighting = ["soft skylight", "small warm gate glow"]
    avoid = ["real brand names", "photo textures", "dense debris"]
  }

  region region_atrium_floor: interior {
    name = "Atrium Floor"
    purpose = "Primary playable mall space."
    mood = "quiet and open"
    bounds.center = [0, 0, 1.5]
    bounds.size = [16, 12, 3]
    semantic_tags = [mall, atrium, "roblox lowpoly"]
  }

  region region_entry_lane: threshold {
    name = "Entry Lane"
    purpose = "Simple approach path into the mall atrium."
    mood = "dusty and readable"
    bounds.center = [0, -5, 1]
    bounds.size = [4, 2, 2]
    semantic_tags = [entry, path]
  }

  region region_arcade_gate: threshold {
    name = "Arcade Gate"
    purpose = "Expansion hook behind the glowing security gate."
    mood = "hidden and warm"
    bounds.center = [5, 2, 1.5]
    bounds.size = [2, 1, 3]
    semantic_tags = [arcade, locked, expansion]
  }

  object obj_storefront_row_001: architecture from storefront_row {
    name = "Shuttered Storefront Row"
    region = region_atrium_floor
    source_kit = mall_lowpoly_kit
    transform.position = [-4, 1, 1.5]
    transform.rotation = [0, 0, 0]
    transform.scale = [1, 1, 1]
    material_bindings.wall = mat_painted_concrete
    material_bindings.glass = mat_simple_glass
    semantic_tags = [storefront, architecture, closed]
    state.triangle_count = 4200
    state.mesh_count = 1
    state.texture_count = 2
    state.max_texture_resolution = 1024
    state.material_slots = 2
    state.collision = box
    state.pivot = base_center
  }

  object obj_fountain_planter_001: hero_prop from dry_fountain_planter {
    name = "Dry Fountain Planter"
    region = region_atrium_floor
    source_family = mall_centerpiece
    transform.position = [0, 0, 0.5]
    transform.rotation = [0, 0, 0]
    transform.scale = [1, 1, 1]
    material_bindings.tile = mat_scuffed_tile
    material_bindings.paint = mat_faded_teal
    semantic_tags = [fountain, planter, waypoint]
    gameplay {
      affordances.inspect_planter.action = inspect
      affordances.inspect_planter.reveals = hidden_fountain_waypoint
    }
    state.triangle_count = 2800
    state.mesh_count = 1
    state.texture_count = 2
    state.max_texture_resolution = 1024
    state.material_slots = 2
    state.collision = hull
    state.pivot = base_center
    state.water = false
  }

  object obj_broken_escalator_001: navigation from broken_escalator_rail {
    name = "Broken Escalator Rail"
    region = region_atrium_floor
    source_family = mall_navigation
    transform.position = [3, -2, 1]
    transform.rotation = [0, 0, -30]
    transform.scale = [1, 1, 1]
    material_bindings.rail = mat_dust_gray
    material_bindings.stripe = mat_sun_worn_coral
    semantic_tags = ["blocked path", navigation, rail]
    state.triangle_count = 3400
    state.mesh_count = 1
    state.texture_count = 1
    state.max_texture_resolution = 512
    state.material_slots = 2
    state.collision = box
    state.pivot = base_center
    state.blocked = true
  }

  object obj_security_gate_001: interactive from arcade_security_gate {
    name = "Glowing Arcade Security Gate"
    region = region_arcade_gate
    source_family = mall_doors
    transform.position = [5, 2, 1.5]
    transform.rotation = [0, 0, -90]
    transform.scale = [1, 1, 1]
    material_bindings.frame = mat_dust_gray
    material_bindings.sign = mat_soft_yellow
    semantic_tags = ["security gate", arcade, interactive]
    gameplay {
      affordances.try_gate.action = inspect
      affordances.try_gate.reveals = hidden_arcade_power
    }
    state.triangle_count = 2600
    state.mesh_count = 1
    state.texture_count = 1
    state.max_texture_resolution = 512
    state.material_slots = 2
    state.collision = box
    state.pivot = base_center
    state.locked = true
  }

  relationship rel_fountain_frames_gate: points_toward {
    from = obj_fountain_planter_001
    to = obj_security_gate_001
    description = "The fountain planter subtly points players toward the glowing gate."
  }

  relationship rel_escalator_blocks_path: blocks_path {
    from = obj_broken_escalator_001
    to = region_atrium_floor
    description = "The broken escalator keeps the first playable loop compact."
  }

  relationship rel_storefronts_contain_atrium: contains {
    from = obj_storefront_row_001
    to = region_atrium_floor
    description = "The storefront row defines the atrium edge."
  }

  lighting_plan light_skylight_001: area {
    target = obj_fountain_planter_001
    color = "soft white"
    intensity = 0.7
    purpose = "Soft atrium-wide skylight."
  }

  lighting_plan light_gate_glow_001: point {
    target = obj_security_gate_001
    color = "soft yellow"
    intensity = 0.35
    purpose = "Warm clue light at the arcade gate."
  }

  camera_intent camera_reveal: cinematic_wide {
    target = obj_fountain_planter_001
    purpose = "First impression of the whole Roblox-ready mall atrium."
    transform.position = [-6, -5, 3]
    transform.rotation = [60, 0, -38]
    transform.scale = [1, 1, 1]
    fov_degrees = 50
  }

  camera_intent camera_gate_detail: inspection {
    target = obj_security_gate_001
    purpose = "Read the glowing gate clue and arcade hint."
    transform.position = [3, -0.5, 2]
    transform.rotation = [58, 0, -20]
    transform.scale = [1, 1, 1]
    fov_degrees = 38
  }

  curiosity_anchor curiosity_arcade_gate {
    attached_to = obj_security_gate_001
    visible_clue = "The security gate still glows even though every storefront is closed."
    hidden_fact = "The arcade gate still glows because a backup battery powers the hidden arcade."
    suggested_user_actions = ["inspect gate", "follow warm glow", "open arcade"]
    expansion_options.hidden_arcade_room.label = "Generate the hidden arcade room behind the gate."
    expansion_options.hidden_arcade_room.target_scope = region_arcade_gate
    expansion_options.hidden_arcade_room.required_assets = [lowpoly_arcade_cabinet, ticket_counter]
    expansion_options.hidden_arcade_room.continuity_constraints = ["preserve security gate identity", "preserve mall atrium grid"]
  }

  curiosity_anchor curiosity_fountain_waypoint {
    attached_to = obj_fountain_planter_001
    visible_clue = "The dry fountain planter is arranged like a route marker."
    hidden_fact = "The fountain planter is arranged like a waypoint toward the hidden arcade gate."
    suggested_user_actions = ["inspect planter", "look toward gate", "trace path"]
    expansion_options.waypoint_tiles.label = "Reveal the tile path from the fountain planter to the gate."
    expansion_options.waypoint_tiles.target_scope = region_atrium_floor
    expansion_options.waypoint_tiles.required_assets = [painted_tile_arrow, dust_trail_decal]
    expansion_options.waypoint_tiles.continuity_constraints = ["preserve fountain position", "preserve snap grid"]
  }

  hidden_state hidden_arcade_power {
    attached_to = obj_security_gate_001
    fact = "The arcade gate still glows because a backup battery powers the hidden arcade."
    reveal_condition = "User inspects the glowing security gate."
    visible = false
  }

  hidden_state hidden_fountain_waypoint {
    attached_to = obj_fountain_planter_001
    fact = "The fountain planter is arranged like a waypoint toward the hidden arcade gate."
    reveal_condition = "User inspects the dry fountain planter."
    visible = false
  }

  export scene_graph {
    format = json
    path = "scene_graph.json"
  }

  export roblox_manifest {
    format = json
    path = "dist/exports/abandoned_roblox_mall.roblox_manifest.json"
  }

  export scene_package {
    format = lathepkg
    path = "dist/abandoned_roblox_mall.lathepkg"
  }

  // JSON-only v1 data is preserved below, including object provenance, export
  // metadata, material definitions, build artifacts, and memory.
  // Embedded payload summary: layout=1, materials=7, build_artifacts=1, memory_events=2.
}

