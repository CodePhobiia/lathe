module studio.props.terminals
import std.families.console_terminal
import std.benchmarks.hero_nearmiss

profile interactable_terminal {
  defaults {
    build.optimize.lods = 4
    package.formats = [usd, glb]
    package.manifest = true
    package.include_trace = true
  }

  ensure units(cm)
  ensure manifold
  ensure watertight
  ensure material_slots(max: 4)
  ensure uv_range(set: base, range: 0..1)
  ensure lightmap_uvs
  ensure collision_proxy
}

contract shipping_terminal uses interactable_terminal {
  defaults {
    build.interfaces.clearance = 2cm
  }

  ensure pivots(policy: studio_standard)
  ensure names(policy: studio_standard)
  ensure texel_density(target: 512px_per_m, tolerance: 0.10)
  ensure runtime_budget(draw_calls: 3, texture_memory: 24mb)

  prefer silhouette_readability weight 0.3
  prefer part_coherence weight 0.2
}

critic terminal_prop(a: asset) = weighted {
  prompt_match 0.25
  silhouette_readability 0.15
  topology_quality 0.20
  material_quality 0.15
  runtime_efficiency 0.10
  part_coherence 0.15
}

asset console_terminal: hard_surface_prop from console_terminal_family uses shipping_terminal {
  intent {
    role = "industrial console terminal"
    style = ["industrial", "service_bay", "sci_fi"]
    parts = [
      body,
      bezel_frame,
      screen_panel,
      console_panel,
      stand_base,
      socket_plate,
    ]
    materials = ["painted_steel", "smoked_glass", "rubber_trim"]
    negatives = ["medieval", "organic", "ornate"]
    scale = 1.45m
    interactions = [stand_in_world, read_status, plug_power]
  }

  geometry {
    mode = exact_hard_surface
    seam_classes = [bezel_break, service_panel, base_split]
    edge_classes = [hero_bevel, screen_bevel, support_bevel]
    integration_rules = [boolean_union, preserve_screen_bezel]
  }

  features {
    density = hero
    allow = [screen_bezel, vent_grille, trim_band, support_bracket, edge_break]
  }

  surface {
    program = console_terminal_hero
    patterns = [vent_slats_dense, cargo_fastener_grid]
    palette = industrial_service_console
    material_zones = [painted_steel_body, smoked_glass_screen, rubber_trim_dark]
    materials = [painted_steel_body, smoked_glass_screen, rubber_trim_dark]
    decals = [service_labels, screen_glow]
    bake = [normal, ao, curvature, id]
  }

  assembly {
    components = [console_body_shell, console_bezel, console_screen, console_panel_face, console_stand, power_socket_plate]
    mechanisms = [console_service_panel_mechanism]
  }

  search {
    use = console_hero_search
  }

  repair_policy {
    use = hero_hardsurface_repair
  }

  build {
    shape {
      mode = generate
      candidates = 4
      seed = 27
      symmetry = x
      preserve = [silhouette, part_graph, symmetry, proportions, interfaces]
    }

    topology {
      retopo = auto
      target_quads = 13000
      ngons = forbid
      preserve = [hard_edges, part_borders]
    }

    uv {
      sets = [base, lightmap]
      unwrap = auto
      padding = 8px
      texel_density = 512px_per_m
    }

    surface {
      workflow = pbr_metal_rough
      maps = [basecolor, normal, orm, emissive]
      resolution = 2048px
      bakes = [ao, curvature, id]
      decals = ["service_labels", "screen_glow"]
      id_map = true
    }

    rig {
      type = none
      joints = []
      pivot_policy = studio_standard
      joint_limits = auto
    }

    interfaces {
      sockets = [power_socket]
      anchors = [floor_contact]
      clearance = 2cm
    }

    physics {
      collision = convex_decomp
      max_hulls = 6
      mass = auto
      center_of_mass = auto
    }

    optimize {
      lods = 4
      atlas = true
      draw_calls = 2
      texture_budget = 24mb
      mesh_compression = true
    }
  }

  validate {
    score = terminal_prop
    threshold = 0.85

    repair {
      mode = auto_until_pass
      max_rounds = 4
      allow = [
        reselect_candidate,
        enforce_symmetry,
        seal_mesh,
        retopo_auto,
        reduce_tris,
        repack_uvs,
        rebake_maps,
        normalize_pivots,
        create_collision_proxy,
        generate_lods,
      ]
      deny = [rebuild_shape]
    }
  }

  package {
    formats = [usd, glb]
    previews = [turntable, wireframe, material_ids, uv_layout, collision, lod_sheet]
    embed_textures = false
  }

  publish {
    registry = "props/terminals/console_terminal"
    version = "0.1.0"
    tags = ["console", "terminal", "industrial"]
    visibility = studio
    approval = required
    channel = dev
  }
}

test console_terminal_language_surface {
  asset = console_terminal
  assert assembly.family == console_terminal_family
  assert surface.palette == industrial_service_console
  assert space.use == console_hero_search
}

benchmark console_terminal_hero_language {
  asset = console_terminal
  must_pass = true
  compare_against = [legacy_console_terminal_v06_fixture]
  assert score >= threshold
}
