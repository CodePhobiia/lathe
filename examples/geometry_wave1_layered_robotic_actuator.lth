module examples.geometry_wave1.layered_robotic_actuator

asset geometry_wave1_layered_robotic_actuator: mechanical_assembly {
  intent {
    role = "layered robotic actuator housing"
    style = ["robotics", "industrial", "wave1_geometry"]
    parts = [body, hinge_l, hinge_r, socket_plate, clamp_l, clamp_r, foot_l, foot_r]
    materials = [painted_steel, bare_metal, black_rubber]
    scale = 0.85m
  }

  features {
    density = hero
    allow = [layer_plate, corner_guard, socket_point, bolt_grid, raised_ridge]
  }

  build {
    shape {
      mode = generate
      candidates = 2
      seed = 124
      symmetry = x
      detail_density = high
      edge_complexity = high
      edge_treatment = chamfered
      ridge_density = medium
      greeble_density = high
      surface_layer_count = 4
      modular_attachment_points = 6
      detail_zones = [body, socket_plate]
    }
    rig { type = rigid_mechanical joints = [hinge_l, hinge_r] }
    interfaces {}
  }

  validate { threshold = 0.80 }
  package { formats = [glb] }
}
