// Tutorial asset for docs/tutorial/first_asset.md.
// Intentionally minimal: one profile, one contract, one critic, one asset, one variant.
module studio.props.furniture

material stained_oak_body {
  basecolor = [126, 88, 52]
  metallic = 0.0
  roughness = 0.64
  roughness_range = [0.52, 0.78]
  emissive = [0, 0, 0]
  surface_profile = wood_grain
  wear = 0.12
  normal_intensity = 0.10
}

material matte_laminate_back {
  basecolor = [84, 72, 60]
  metallic = 0.0
  roughness = 0.76
  roughness_range = [0.66, 0.86]
  emissive = [0, 0, 0]
  surface_profile = painted_panel
  wear = 0.06
  normal_intensity = 0.04
}

material shadow_gap_paint {
  basecolor = [36, 32, 28]
  metallic = 0.0
  roughness = 0.70
  roughness_range = [0.60, 0.84]
  emissive = [0, 0, 0]
  surface_profile = painted_panel
  wear = 0.08
  normal_intensity = 0.06
}

pattern vertical_oak_grain {
  family = linear_repeat
  spacing_cm = 3.0
  emphasis = wood_readability
}

pattern shelf_edge_wear {
  family = edge_repeat
  spacing_cm = 7.5
  emphasis = contact_wear
}

palette warm_oak_laminate {
  materials = [stained_oak_body, matte_laminate_back, shadow_gap_paint]
}

surface_program tutorial_bookshelf_hero {
  workflow = pbr_metal_rough
  maps = [basecolor, normal, orm, ao, curvature, id]
  bakes = [ao, curvature, id]
  decals = [shelf_alignment_ticks, subtle_corner_wear]
  patterns = [vertical_oak_grain, shelf_edge_wear]
  zones.body = stained_oak_body
  zones.shelves = stained_oak_body
  zones.back = matte_laminate_back
  zones.shadow_gaps = shadow_gap_paint
}

profile interior_prop {
  defaults {
    build.optimize.lods = 3
    package.formats = [usd, glb]
    package.manifest = true
    package.include_trace = true
  }

  ensure units(cm)
  ensure manifold
  ensure watertight
  ensure material_slots(max: 3)
  ensure uv_range(set: base, range: 0..1)
}

contract furniture_prop uses interior_prop {
  defaults {
    build.interfaces.clearance = 1cm
  }

  ensure pivots(policy: studio_standard)
  ensure names(policy: studio_standard)
  ensure texel_density(target: 512px_per_m, tolerance: 0.10)
  ensure runtime_budget(draw_calls: 2, texture_memory: 16mb)

  prefer silhouette_readability weight 0.3
  prefer part_coherence weight 0.2
}

critic furniture_prop_critic(a: asset) = weighted {
  prompt_match 0.25
  silhouette_readability 0.20
  topology_quality 0.20
  material_quality 0.15
  runtime_efficiency 0.10
  part_coherence 0.10
}

asset bookshelf: hard_surface_prop uses furniture_prop {
  intent {
    role = "three-shelf wooden bookshelf"
    style = ["warm", "domestic", "utilitarian"]
    parts = [base, shelf1, shelf2, shelf3, back]
    materials = ["stained_oak", "matte_laminate", "shadow_gap_paint"]
    negatives = ["ornate", "toy_like", "rickety"]
    scale = 1.2m
    interactions = [place, lean_on]
  }

  geometry {
    mode = exact_hard_surface
    seam_classes = [shelf_join, back_panel_break]
    edge_classes = [hero_bevel, support_bevel]
    integration_rules = [boolean_union, preserve_shelf_spacing]
  }

  features {
    density = medium
    allow = [trim_band, fastener_strip, edge_break]
  }

  surface {
    program = tutorial_bookshelf_hero
    patterns = [vertical_oak_grain, shelf_edge_wear]
    palette = warm_oak_laminate
    material_zones = [stained_oak_body, matte_laminate_back, shadow_gap_paint]
    materials = [stained_oak_body, matte_laminate_back, shadow_gap_paint]
    decals = [shelf_alignment_ticks, subtle_corner_wear]
    bake = [normal, ao, curvature, id]
  }

  build {
    shape {
      mode = generate
      candidates = 4
      seed = 7
      symmetry = x
      preserve = [silhouette, part_graph, symmetry, proportions]
    }

    topology {
      retopo = auto
      target_quads = 6000
      ngons = forbid
      preserve = [hard_edges, part_borders]
    }

    uv {
      sets = [base, lightmap]
      unwrap = auto
      padding = 8px
      texel_density = 512px_per_m
    }

    surface {
      workflow = pbr_metal_rough
      maps = [basecolor, normal, orm]
      resolution = 2048px
      bakes = [ao, curvature, id]
      decals = [shelf_alignment_ticks, subtle_corner_wear]
      id_map = true
    }

    rig {
      type = none
      joints = []
      pivot_policy = studio_standard
      joint_limits = auto
    }

    interfaces {
      sockets = []
      pivots = [pivot(id: floor_contact, pivot_type: contact)]
      clearance = 1cm
    }

    physics {
      collision = convex_decomp
      max_hulls = 3
      mass = auto
      center_of_mass = auto
    }

    optimize {
      lods = 3
      atlas = true
      draw_calls = 2
      texture_budget = 16mb
      mesh_compression = true
    }
  }

  validate {
    score = furniture_prop_critic
    threshold = 0.82

    repair {
      mode = auto_until_pass
      max_rounds = 3
      allow = [
        reselect_candidate,
        enforce_symmetry,
        seal_mesh,
        retopo_auto,
        reduce_tris,
        repack_uvs,
        rebake_maps,
        normalize_pivots,
        create_collision_proxy,
        generate_lods,
      ]
      deny = [rebuild_shape]
    }
  }

  package {
    formats = [usd, glb]
    previews = [turntable, wireframe, material_ids, uv_layout, collision, lod_sheet]
    embed_textures = false
  }

  publish {
    registry = "props/furniture/bookshelf"
    version = "0.1.0"
    tags = ["decoration", "static", "interactable"]
    visibility = studio
    approval = required
    channel = dev
  }
}

variant tall_bookshelf on bookshelf {
  set intent.scale = 1.8m
  append intent.parts = shelf4
  set build.shape.seed = 11
  set build.optimize.texture_budget = 24mb
}

test bookshelf_language_surface {
  asset = bookshelf
  assert intent.scale == 1.2m
  assert build.shape.mode == generate
  assert validate.threshold == 0.82
}
