module examples.geometry_wave1.ridged_console_terminal

asset geometry_wave1_ridged_console_terminal: hard_surface_prop {
  intent {
    role = "ridged industrial console terminal"
    style = ["service_bay", "sci_fi", "wave1_geometry"]
    parts = [body, bezel_frame, screen_panel, console_panel, stand_base, socket_plate]
    materials = [painted_steel, smoked_glass, dark_rubber]
    scale = 1.35m
  }

  features {
    density = hero
    allow = [raised_ridge, panel_seam, bolt_grid, socket_point, screen_bezel]
  }

  build {
    shape {
      mode = generate
      candidates = 2
      seed = 103
      symmetry = x
      detail_density = hero
      edge_complexity = medium
      panelization = high
      ridge_density = hero
      greeble_density = high
      modular_attachment_points = 4
      detail_zones = [body, console_panel, socket_plate]
    }
    rig { type = none joints = [] }
    interfaces {}
  }

  validate { threshold = 0.80 }
  package { formats = [glb] }
}
