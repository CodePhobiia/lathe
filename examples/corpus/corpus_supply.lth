module corpus.supplies
import std.families.supply_container

profile shipping_container_prop {
  defaults {
    build.optimize.lods = 4
    package.formats = [usd, glb]
    package.manifest = true
    package.include_trace = true
  }

  ensure units(cm)
  ensure manifold
  ensure watertight
  ensure material_slots(max: 4)
  ensure uv_range(set: base, range: 0..1)
  ensure lightmap_uvs
  ensure collision_proxy
}

contract shipping_prop uses shipping_container_prop {
  defaults {
    build.interfaces.clearance = 2cm
  }

  ensure pivots(policy: studio_standard)
  ensure names(policy: studio_standard)
  ensure texel_density(target: 512px_per_m, tolerance: 0.10)
  ensure runtime_budget(draw_calls: 3, texture_memory: 24mb)

  prefer silhouette_readability weight 0.3
  prefer part_coherence weight 0.2
}

critic supply_prop(a: asset) = weighted {
  prompt_match 0.23
  silhouette_readability 0.16
  topology_quality 0.20
  material_quality 0.16
  runtime_efficiency 0.10
  part_coherence 0.15
}

asset corpus_supply: hard_surface_prop from supply_container_family uses shipping_prop {
  intent {
    role = "rugged supply container"
    style = ["industrial", "field_kit", "shipping"]
    parts = [
      body,
      lid_panel,
      strap_band,
      latch_plate,
      handle_l,
      handle_r,
      foot_l,
      foot_r,
    ]
    materials = [painted_steel_body, rubber_trim_dark, warning_paint]
    negatives = ["ornate", "organic", "toy_like"]
    scale = 0.85m
    interactions = [carry, secure_supplies, place_in_world]
  }

  geometry {
    mode = exact_hard_surface
    seam_classes = [panel_seam, lid_break, strap_break, clasp_cut]
    edge_classes = [hero_bevel, support_bevel, trim_edge]
    integration_rules = [boolean_union, preserve_lid_break, preserve_strap_profile]
  }

  features {
    density = hero
    allow = [inset_panel, frame_lip, trim_band, clasp_set, recessed_handle, support_bracket, edge_break, fastener_strip]
  }

  surface {
    program = supply_container_hero
    patterns = [cargo_fastener_grid, warning_stripe_band]
    palette = industrial_crate_hero_palette
    material_zones = [painted_steel_body, rubber_trim_dark, warning_paint]
    materials = [painted_steel_body, rubber_trim_dark, warning_paint]
    decals = [shipping_mark, service_label]
    bake = [normal, ao, curvature, id]
  }

  assembly {
    components = [supply_body_shell, supply_lid_panel, supply_strap_band, supply_latch_plate, supply_handle_l, supply_handle_r, supply_foot_l, supply_foot_r]
    mechanisms = [crate_latch_mechanism]
  }

  search {
    use = supply_hero_search
  }

  repair_policy {
    use = hero_hardsurface_repair
  }

  build {
    shape {
      mode = generate
      candidates = 4
      seed = 73
      symmetry = x
      preserve = [silhouette, part_graph, symmetry, proportions]
    }

    topology {
      retopo = auto
      target_quads = 12000
      ngons = forbid
      preserve = [hard_edges, part_borders]
    }

    uv {
      sets = [base, lightmap]
      unwrap = auto
      padding = 8px
      texel_density = 512px_per_m
    }

    surface {
      workflow = pbr_metal_rough
      maps = [basecolor, normal, orm]
      resolution = 2048px
      bakes = [ao, curvature, id]
      decals = [shipping_mark, service_label]
      id_map = true
    }

    rig {
      type = none
      joints = []
      pivot_policy = studio_standard
      joint_limits = auto
    }

    interfaces {
      sockets = [socket(id: cargo_anchor, socket_type: attach)]
      pivots = [pivot(id: floor_contact, pivot_type: contact)]
      clearance = 2cm
    }

    physics {
      collision = convex_decomp
      max_hulls = 5
      mass = auto
      center_of_mass = auto
    }

    optimize {
      lods = 4
      atlas = true
      draw_calls = 2
      texture_budget = 24mb
      mesh_compression = true
    }
  }

  validate {
    score = supply_prop
    threshold = 0.84

    repair {
      mode = auto_until_pass
      max_rounds = 4
      allow = [
        reselect_candidate,
        enforce_symmetry,
        seal_mesh,
        retopo_auto,
        reduce_tris,
        repack_uvs,
        rebake_maps,
        reauthor_surface_layer,
        normalize_pivots,
        create_collision_proxy,
        generate_lods,
      ]
      deny = [rebuild_shape]
    }
  }

  package {
    formats = [usd, glb]
    previews = [turntable, wireframe, material_ids, uv_layout, collision, lod_sheet]
    embed_textures = false
  }
}

test corpus_supply_language_surface {
  asset = corpus_supply
  assert from == supply_container_family
  assert surface.program == supply_container_hero
  assert space.use == supply_hero_search
}

benchmark corpus_supply_hero_language {
  asset = corpus_supply
  must_pass = true
  assert score >= threshold
}
