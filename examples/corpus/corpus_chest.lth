module corpus.chests
import std.families.brassbound_chest
import std.benchmarks.hero_nearmiss

profile unreal_interactable_prop {
  defaults {
    build.optimize.lods = 4
    package.formats = [usd, glb]
    package.manifest = true
    package.include_trace = true
  }

  ensure units(cm)
  ensure manifold
  ensure watertight
  ensure material_slots(max: 4)
  ensure uv_range(set: base, range: 0..1)
  ensure lightmap_uvs
  ensure collision_proxy
}

contract shipping_prop uses unreal_interactable_prop {
  defaults {
    build.interfaces.clearance = 2cm
  }

  ensure pivots(policy: studio_standard)
  ensure names(policy: studio_standard)
  ensure texel_density(target: 512px_per_m, tolerance: 0.10)
  ensure runtime_budget(draw_calls: 3, texture_memory: 32mb)

  prefer silhouette_readability weight 0.3
  prefer part_coherence weight 0.2
}

critic hero_prop(a: asset) = weighted {
  prompt_match 0.25
  silhouette_readability 0.15
  topology_quality 0.20
  material_quality 0.15
  runtime_efficiency 0.10
  part_coherence 0.15
}

asset corpus_chest: hard_surface_prop from brassbound_chest_family uses shipping_prop {
  intent {
    role = "ornate brassbound loot chest"
    style = ["adventure", "stylized", "wood_and_brass"]
    parts = [
      body,
      lid_panel,
      front_hatch,
      lock_plate,
      handle_l,
      handle_r,
      foot_l,
      foot_r,
    ]
    materials = ["oak_planks", "brass_bands", "red_velvet_lining"]
    negatives = ["modern", "plastic", "sci_fi"]
    scale = 0.8m
    interactions = [open_lid, collect_loot, place_in_world]
  }

  geometry {
    mode = exact_hard_surface
    seam_classes = [panel_seam, lid_break, clasp_cut]
    edge_classes = [hero_bevel, support_bevel, trim_edge]
    integration_rules = [boolean_union, preserve_lid_break]
  }

  features {
    density = hero
    allow = [inset_panel, frame_lip, trim_band, clasp_set, recessed_handle, support_bracket, edge_break]
  }

  surface {
    program = chest_wood_brass_hero
    patterns = [plank_spacing_hero, rivet_row_hero]
    palette = fantasy_brassbound
    material_zones = [oak_body, aged_brass_trim, velvet_interior]
    materials = [oak_body, aged_brass_trim, velvet_interior]
    decals = [crest, trim_wear]
    bake = [normal, ao, curvature, id]
  }

  assembly {
    components = [chest_body, chest_lid, brass_latch_set, front_clasp, side_handle_l, side_handle_r, support_foot_l, support_foot_r, chest_interior_liner]
    mechanisms = [lid_hinge_mechanism]
  }

  search {
    use = chest_hero_search
  }

  repair_policy {
    use = hero_hardsurface_repair
  }

  build {
    shape {
      mode = generate
      candidates = 6
      seed = 19
      symmetry = x
      preserve = [silhouette, part_graph, symmetry, proportions]
    }

    topology {
      retopo = auto
      target_quads = 12000
      ngons = forbid
      preserve = [hard_edges, part_borders]
    }

    uv {
      sets = [base, lightmap]
      unwrap = auto
      padding = 8px
      texel_density = 512px_per_m
    }

    surface {
      workflow = pbr_metal_rough
      maps = [basecolor, normal, orm]
      resolution = 2048px
      bakes = [ao, curvature, id]
      decals = ["crest", "trim_wear"]
      id_map = true
    }

    rig {
      type = rigid_mechanical
      joints = [front_hatch]
      pivot_policy = studio_standard
      joint_limits = auto
    }

    interfaces {
      sockets = [socket(id: loot_anchor, socket_type: attach)]
      pivots = [pivot(id: floor_contact, pivot_type: contact)]
      clearance = 2cm
    }

    physics {
      collision = convex_decomp
      max_hulls = 6
      mass = auto
      center_of_mass = auto
    }

    optimize {
      lods = 4
      atlas = true
      draw_calls = 2
      texture_budget = 16mb
      mesh_compression = true
    }
  }

  validate {
    score = hero_prop
    threshold = 0.84

    repair {
      mode = auto_until_pass
      max_rounds = 4
      allow = [
        reselect_candidate,
        enforce_symmetry,
        seal_mesh,
        retopo_auto,
        reduce_tris,
        repack_uvs,
        rebake_maps,
        normalize_pivots,
        create_collision_proxy,
        generate_lods,
      ]
      deny = [rebuild_shape]
    }
  }

  package {
    formats = [usd, glb]
    previews = [turntable, wireframe, material_ids, uv_layout, collision, lod_sheet]
    embed_textures = false
  }

  publish {
    registry = "props/containers/corpus_chest"
    version = "0.1.0"
    tags = ["chest", "loot", "container", "fantasy"]
    visibility = studio
    approval = required
    channel = dev
  }
}

test corpus_chest_language_surface {
  asset = corpus_chest
  assert assembly.family == brassbound_chest_family
  assert surface.palette == fantasy_brassbound
  assert space.use == chest_hero_search
}

benchmark corpus_chest_hero_language {
  asset = corpus_chest
  must_pass = true
  compare_against = [legacy_brassbound_chest_v06_fixture]
  assert score >= threshold
}
