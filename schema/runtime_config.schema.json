{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schemas/runtime_config-v1.json",
  "title": "Lathe Runtime Config v1",
  "description": "JSON schema for runtime_config files passed via --runtime-config. Mirrors DEFAULT_RUNTIME_CONFIG in lathe/runtime_config.py. Unknown keys are permitted (warned at load time) until stricter gates land in a later release.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "shape": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "description": "Provider alias or fully-qualified provider id (e.g. auto, reference_conditioned_v1, hunyuan2_1_http, vggt_local, codex_imagegen)."
        },
        "strict": { "type": "boolean" },
        "allow_fallback": {
          "type": "boolean",
          "description": "BL-37 (Plan 08 Phase 8): explicit opt-in to legacy 'fall back to reference_conditioned on learned-provider error' behavior. In V0.1.x informational; V0.2 flips strict=True for learned providers and this flag becomes the sole non-strict opt-out."
        },
        "providers": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "hunyuan2_1_http": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "base_url": { "type": "string", "format": "uri" },
                "timeout_s": { "type": "integer", "minimum": 1, "maximum": 3600 },
                "url_allowlist": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "remove_background": { "type": "boolean" },
                "texture": { "type": "boolean" },
                "octree_resolution": { "type": "integer", "minimum": 1 },
                "num_inference_steps": { "type": "integer", "minimum": 1 },
                "guidance_scale": { "type": "number" },
                "face_count": { "type": "integer", "minimum": 1 },
                "type": { "type": "string" }
              }
            },
            "vggt_local": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "path": { "type": "string" },
                "weights": { "type": "string" },
                "device": { "type": "string" },
                "dtype": { "type": "string" },
                "max_views": { "type": "integer", "minimum": 1 },
                "stride": { "type": "integer", "minimum": 1 },
                "min_confidence": { "type": "number" },
                "max_edge_ratio": { "type": "number" },
                "candidate_variants": { "type": "integer", "minimum": 1 },
                "use_point_head": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "adapter": { "type": "string" },
        "strict": { "type": "boolean" },
        "blender": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "path": { "type": ["string", "null"] },
            "timeout_s": { "type": "integer", "minimum": 1, "maximum": 3600 },
            "asset_libraries": {
              "type": "array",
              "items": { "type": "string" }
            },
            "addons": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "uv": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "adapter": { "type": "string" },
        "strict": { "type": "boolean" },
        "xatlas": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "resolution": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "backend": { "type": "string" },
        "fallback_mode": { "type": "string" },
        "codex_imagegen": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "mode": { "type": "string" },
            "request_dir": { "type": "string" },
            "output_dir": { "type": "string" }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "blender": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "path": { "type": ["string", "null"] },
            "strict": { "type": "boolean" },
            "allow_autoexec": { "type": "boolean" },
            "trusted": { "type": "boolean" },
            "preserve_blend": { "type": "string" },
            "asset_libraries": {
              "type": "array",
              "items": { "type": "string" }
            },
            "addons": {
              "type": "array",
              "items": { "type": "string" }
            },
            "render_device": { "type": "string" },
            "request_dir": { "type": "string" },
            "output_dir": { "type": "string" }
          }
        }
      }
    },
    "repair": {
      "type": "object",
      "description": "BL-33 (Plan 08 Phase 3): autonomous multi-round repair loop settings consumed by lathe/repair_loop.py.",
      "additionalProperties": true,
      "properties": {
        "autonomous": { "type": "boolean" },
        "max_rounds": { "type": "integer", "minimum": 0, "maximum": 32 },
        "max_rounds_override": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 32,
          "description": "Invocation-time override for asset-declared validate.repair.max_rounds. When set, wins over the asset value (and over the default max_rounds). Intended for fast iteration / diagnostics; production builds should leave this unset so the asset declaration is authoritative."
        },
        "min_improvement": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "budget_seconds": { "type": "number", "minimum": 1.0, "maximum": 3600.0 }
      }
    },
    "publish": {
      "type": "object",
      "description": "BL-31 (Plan 08 Phase 1): publish-runner target configuration consumed by lathe/core/stages/publish.py and the `lathe publish` CLI.",
      "additionalProperties": true,
      "properties": {
        "target": {
          "type": "string",
          "description": "Driver id: local_fs, s3, supabase, git_lfs, or a custom-registered driver."
        },
        "signing_key": { "type": "string" },
        "asset": { "type": "string" },
        "version": { "type": "string" },
        "target_dir": { "type": "string" },
        "bucket": { "type": "string" },
        "prefix": { "type": "string" },
        "region": { "type": "string" },
        "base_url": { "type": "string" },
        "url_allowlist": {
          "type": "array",
          "items": { "type": "string" }
        },
        "service_key": { "type": "string" },
        "repo_dir": { "type": "string" },
        "branch": { "type": "string" },
        "remote": { "type": "string" },
        "timeout_s": { "type": "number", "minimum": 1 }
      }
    }
  }
}
