{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schema/wonder/dream-brief-v1.json",
  "title": "Lathe Wonder Dream Brief v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brief_id",
    "title",
    "one_sentence",
    "scale",
    "intent",
    "style",
    "required_elements",
    "constraints",
    "export_targets"
  ],
  "properties": {
    "schema_version": {
      "const": "lathe.dream_brief.v1"
    },
    "brief_id": {
      "$ref": "#/$defs/snake_id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "one_sentence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "source_prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "genre": {
      "$ref": "#/$defs/string_tags"
    },
    "mood": {
      "$ref": "#/$defs/string_tags"
    },
    "scale": {
      "enum": [
        "single_room",
        "small_courtyard",
        "street_corner",
        "multi_room_seed",
        "modular_kit"
      ]
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setting",
        "emotional_goal",
        "primary_interaction"
      ],
      "properties": {
        "setting": {
          "type": "string",
          "minLength": 1
        },
        "emotional_goal": {
          "type": "string",
          "minLength": 1
        },
        "primary_interaction": {
          "type": "string",
          "minLength": 1
        },
        "spatial_logic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette",
        "materials",
        "lighting",
        "form_language"
      ],
      "properties": {
        "palette": {
          "$ref": "#/$defs/string_tags"
        },
        "materials": {
          "$ref": "#/$defs/string_tags"
        },
        "lighting": {
          "type": "string",
          "minLength": 1
        },
        "form_language": {
          "$ref": "#/$defs/string_tags"
        },
        "avoid_styles": {
          "$ref": "#/$defs/string_tags"
        }
      }
    },
    "required_elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "role",
          "priority"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/snake_id"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "$ref": "#/$defs/scene_role"
          },
          "priority": {
            "enum": [
              "must",
              "should"
            ]
          }
        }
      }
    },
    "avoid": {
      "$ref": "#/$defs/string_tags"
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "complexity",
        "performance"
      ],
      "properties": {
        "platform": {
          "$ref": "#/$defs/platform"
        },
        "complexity": {
          "enum": [
            "preview",
            "balanced",
            "final"
          ]
        },
        "performance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "triangle_budget": {
              "type": "integer",
              "minimum": 1
            },
            "texture_resolution": {
              "type": "integer",
              "minimum": 64
            },
            "mobile_friendly": {
              "type": "boolean"
            }
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "safety_profile": {
              "enum": [
                "general",
                "teen",
                "mature_internal"
              ]
            },
            "ip_policy": {
              "enum": [
                "original_only",
                "user_owned_refs",
                "licensed_refs"
              ]
            }
          }
        }
      }
    },
    "camera_intents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "framing"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/snake_id"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "framing": {
            "$ref": "#/$defs/camera_framing"
          }
        }
      }
    },
    "curiosity_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "export_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/export_target"
      }
    },
    "authoring_notes": {
      "type": "string"
    }
  },
  "$defs": {
    "snake_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,79}$"
    },
    "string_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "scene_role": {
      "enum": [
        "architecture",
        "hero_prop",
        "environment_structure",
        "dressing_prop",
        "light_fixture",
        "navigation",
        "interactive",
        "narrative_clue"
      ]
    },
    "platform": {
      "enum": [
        "generic",
        "blender",
        "glb",
        "roblox",
        "unity",
        "unreal",
        "godot"
      ]
    },
    "export_target": {
      "enum": [
        "lathe_source",
        "scene_graph",
        "scene_package",
        "blend",
        "glb",
        "usd",
        "fbx",
        "roblox_manifest",
        "godot_manifest",
        "unity_manifest",
        "unreal_manifest"
      ]
    },
    "camera_framing": {
      "enum": [
        "cinematic_wide",
        "inspection",
        "topdown",
        "debug",
        "contact_sheet",
        "before_after"
      ]
    }
  }
}
