{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schema/wonder/render-comparison-v1.json",
  "title": "Lathe Wonder Render Comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "camera_lock_status",
    "before_hash",
    "after_hash",
    "dimensions",
    "pixel_delta",
    "semantic_delta",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "lathe.render_comparison.v1"
    },
    "camera_lock_status": {
      "enum": [
        "passed",
        "not_provided",
        "failed"
      ]
    },
    "camera_hash": {
      "$ref": "#/$defs/sha256"
    },
    "before_hash": {
      "$ref": "#/$defs/sha256"
    },
    "after_hash": {
      "$ref": "#/$defs/sha256"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pixel_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_pixels",
        "changed_ratio"
      ],
      "properties": {
        "changed_pixels": {
          "type": "integer",
          "minimum": 0
        },
        "changed_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "semantic_delta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "not_evaluated",
            "passed",
            "failed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "expected_targets_changed": {
          "type": "boolean"
        },
        "protected_targets_unchanged": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "required": [
            "status",
            "reason"
          ]
        },
        {
          "required": [
            "expected_targets_changed",
            "protected_targets_unchanged"
          ]
        }
      ]
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
