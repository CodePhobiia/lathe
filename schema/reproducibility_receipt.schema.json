{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lathe.dev/schema/reproducibility_receipt.schema.json",
  "title": "Lathe Reproducibility Receipt",
  "description": "Signed receipt binding a completed Lathe build to its environment fingerprint + stage digests (SEC-NEW-2, V0.2 P0).",
  "type": "object",
  "required": ["schema_version", "snapshot", "signer_id", "timestamp", "env_fingerprint", "signature"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "snapshot": {
      "type": "object",
      "description": "Embedded .lathe_snapshot.json contents (RPT-4).",
      "required": ["schemaVersion", "stages", "timestamp"],
      "additionalProperties": true
    },
    "signer_id": {
      "type": "string",
      "description": "Signer identity (email, CI job id, etc.)."
    },
    "timestamp": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp when the receipt was generated."
    },
    "env_fingerprint": {
      "type": "object",
      "required": ["python_version", "platform", "git_sha", "manifold3d_version"],
      "additionalProperties": true,
      "properties": {
        "python_version": { "type": "string" },
        "python_implementation": { "type": "string" },
        "platform": { "type": "string" },
        "git_sha": { "type": "string" },
        "manifold3d_version": { "type": "string" }
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "value_hex", "public_key_hex"],
      "additionalProperties": true,
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "ed25519"
        },
        "value_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]+$",
          "description": "Hex-encoded ed25519 signature bytes."
        },
        "public_key_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Hex-encoded raw ed25519 public key (32 bytes)."
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the canonical signed payload (sort_keys, no whitespace)."
        }
      }
    }
  }
}
