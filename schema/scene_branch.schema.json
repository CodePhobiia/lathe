{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schema/wonder/scene-branch-v1.json",
  "title": "Lathe Wonder Scene Branch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_id",
    "branch_id",
    "name",
    "parent_branch",
    "base_version_id",
    "head_version_id",
    "versions"
  ],
  "properties": {
    "schema_version": {
      "const": "lathe.scene_branch.v1"
    },
    "scene_id": {
      "$ref": "#/$defs/snake_id"
    },
    "branch_id": {
      "$ref": "#/$defs/branch_id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "parent_branch": {
      "$ref": "#/$defs/branch_id"
    },
    "base_version_id": {
      "$ref": "#/$defs/version_id"
    },
    "head_version_id": {
      "$ref": "#/$defs/version_id"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/version_node"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/state_value"
      }
    }
  },
  "$defs": {
    "snake_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,79}$"
    },
    "branch_id": {
      "$ref": "#/$defs/snake_id"
    },
    "version_id": {
      "type": "string",
      "pattern": "^version_[a-z0-9_]{3,128}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "state_value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "version_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "branch_id",
        "scene_version",
        "scene_fingerprint",
        "parents"
      ],
      "properties": {
        "version_id": {
          "$ref": "#/$defs/version_id"
        },
        "branch_id": {
          "$ref": "#/$defs/branch_id"
        },
        "scene_version": {
          "type": "integer",
          "minimum": 1
        },
        "scene_fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "parents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/version_id"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/state_value"
          }
        }
      }
    }
  }
}
