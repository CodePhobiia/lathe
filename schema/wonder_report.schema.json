{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schema/wonder/wonder-report-v1.json",
  "title": "Lathe Wonder Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_id",
    "scene_version",
    "mode",
    "status",
    "summary",
    "counts",
    "artifacts",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "lathe.wonder_report.v1"
    },
    "scene_id": {
      "$ref": "#/$defs/snake_id"
    },
    "scene_version": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "enum": [
        "preview",
        "final"
      ]
    },
    "build_options": {
      "$ref": "#/$defs/build_options"
    },
    "status": {
      "enum": [
        "golden_fixture_ready",
        "proxy_scene_package_built",
        "passed",
        "passed_with_warnings",
        "failed"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "artifact_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "score"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "passed_with_warnings",
            "failed"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "diagnostics": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "optional_lanes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/lane_status"
      }
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/relative_path"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 800
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "snake_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,79}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?!/).+$"
    },
    "build_options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "executor",
        "mode",
        "runtime_config",
        "deterministic",
        "allow_fallback",
        "strict",
        "diagnostic_policy",
        "runtime",
        "effective_runtime",
        "fallbacks"
      ],
      "properties": {
        "schema_version": {
          "const": "lathe.scene_build_options.v1"
        },
        "executor": {
          "const": "lathe.scene.executor.offline_proxy_v1"
        },
        "mode": {
          "enum": [
            "preview",
            "final"
          ]
        },
        "runtime_config": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provided",
            "path"
          ],
          "properties": {
            "provided": {
              "type": "boolean"
            },
            "path": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 500
            }
          }
        },
        "deterministic": {
          "type": "boolean"
        },
        "allow_fallback": {
          "type": "boolean"
        },
        "strict": {
          "type": "boolean"
        },
        "diagnostic_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scene_validation",
            "plan_diagnostics",
            "fallback_diagnostics"
          ],
          "properties": {
            "scene_validation": {
              "type": "string",
              "minLength": 1
            },
            "plan_diagnostics": {
              "type": "string",
              "minLength": 1
            },
            "fallback_diagnostics": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider_calls",
            "asset_build",
            "asset_materialization",
            "renderer",
            "exporter"
          ],
          "properties": {
            "provider_calls": {
              "const": "not_executed"
            },
            "asset_build": {
              "enum": [
                "deterministic_proxy_manifest",
                "lathe.asset_build_pipeline.v1"
              ]
            },
            "asset_materialization": {
              "enum": [
                "not_executed",
                "lathe.scene.materialize.v1"
              ]
            },
            "renderer": {
              "const": "lathe.scene.proxy_renderer.v1"
            },
            "exporter": {
              "const": "lathe.scene.proxy_glb_exporter.v1"
            }
          }
        },
        "effective_runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shape_provider",
            "shape_strict",
            "shape_allow_fallback"
          ],
          "properties": {
            "shape_provider": {
              "type": "string",
              "minLength": 1
            },
            "shape_strict": {
              "type": "boolean"
            },
            "shape_allow_fallback": {
              "type": "boolean"
            }
          }
        },
        "fallbacks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deterministic_proxy_assets",
            "deterministic_proxy_renderer",
            "deterministic_proxy_glb_exporter",
            "provider_fallbacks_executed"
          ],
          "properties": {
            "deterministic_proxy_assets": {
              "const": true
            },
            "deterministic_proxy_renderer": {
              "const": true
            },
            "deterministic_proxy_glb_exporter": {
              "const": true
            },
            "provider_fallbacks_executed": {
              "const": false
            }
          }
        }
      }
    },
    "lane_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "blocking",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "skipped_optional",
            "blocked",
            "failed"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "code",
        "severity",
        "path",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "#/$defs/snake_id"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "contract": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
