{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schema/wonder/roblox-profile-v1.json",
  "title": "Lathe Wonder Roblox Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "display_name",
    "units",
    "budgets",
    "mesh",
    "collision",
    "material",
    "naming",
    "pivot",
    "snap_grid",
    "mobile"
  ],
  "properties": {
    "schema_version": {
      "const": "lathe.roblox_profile.v1"
    },
    "profile_id": {
      "const": "roblox_lowpoly"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length",
        "scale"
      ],
      "properties": {
        "length": {
          "const": "studs"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "budgets": {
      "$ref": "#/$defs/budgets"
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_meshes_per_object",
        "prefer_shared_meshes"
      ],
      "properties": {
        "max_meshes_per_object": {
          "type": "integer",
          "minimum": 1
        },
        "prefer_shared_meshes": {
          "type": "boolean"
        }
      }
    },
    "collision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "required_roles",
        "allowed_modes",
        "max_primitives_per_object"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "required_roles": {
          "$ref": "#/$defs/role_list"
        },
        "allowed_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "box",
              "hull",
              "mesh"
            ]
          }
        },
        "max_primitives_per_object": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_slots_per_mesh",
        "prefer_vertex_colors",
        "allow_pbr_textures"
      ],
      "properties": {
        "max_slots_per_mesh": {
          "type": "integer",
          "minimum": 1
        },
        "prefer_vertex_colors": {
          "type": "boolean"
        },
        "allow_pbr_textures": {
          "type": "boolean"
        }
      }
    },
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "pattern",
        "max_length"
      ],
      "properties": {
        "policy": {
          "const": "lower_snake_case"
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "max_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      }
    },
    "pivot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "required_roles",
        "allowed_modes"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "required_roles": {
          "$ref": "#/$defs/role_list"
        },
        "allowed_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "base_center",
              "center",
              "custom"
            ]
          }
        }
      }
    },
    "snap_grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "size_studs",
        "tolerance_studs",
        "axes"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "size_studs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tolerance_studs": {
          "type": "number",
          "minimum": 0
        },
        "axes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "x",
              "y",
              "z"
            ]
          }
        }
      }
    },
    "mobile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_fps",
        "min_score",
        "component_weights"
      ],
      "properties": {
        "target_fps": {
          "type": "integer",
          "minimum": 1
        },
        "min_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "component_weights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "triangle",
            "texture",
            "mesh",
            "collision",
            "material",
            "naming",
            "pivot",
            "snap_grid"
          ],
          "properties": {
            "triangle": {
              "$ref": "#/$defs/weight"
            },
            "texture": {
              "$ref": "#/$defs/weight"
            },
            "mesh": {
              "$ref": "#/$defs/weight"
            },
            "collision": {
              "$ref": "#/$defs/weight"
            },
            "material": {
              "$ref": "#/$defs/weight"
            },
            "naming": {
              "$ref": "#/$defs/weight"
            },
            "pivot": {
              "$ref": "#/$defs/weight"
            },
            "snap_grid": {
              "$ref": "#/$defs/weight"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_scene_triangles",
        "max_mesh_triangles",
        "max_meshes",
        "max_textures",
        "max_texture_resolution",
        "max_materials",
        "max_materials_per_mesh"
      ],
      "properties": {
        "max_scene_triangles": {
          "type": "integer",
          "minimum": 1
        },
        "max_mesh_triangles": {
          "type": "integer",
          "minimum": 1
        },
        "max_meshes": {
          "type": "integer",
          "minimum": 1
        },
        "max_textures": {
          "type": "integer",
          "minimum": 1
        },
        "max_texture_resolution": {
          "type": "integer",
          "minimum": 64
        },
        "max_materials": {
          "type": "integer",
          "minimum": 1
        },
        "max_materials_per_mesh": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "role": {
      "enum": [
        "architecture",
        "hero_prop",
        "environment_structure",
        "dressing_prop",
        "light_fixture",
        "navigation",
        "interactive",
        "narrative_clue"
      ]
    },
    "role_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "weight": {
      "type": "integer",
      "minimum": 0
    }
  }
}
