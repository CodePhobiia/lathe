{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schema/wonder/llm-repair-playbook-v1.json",
  "title": "Lathe Wonder LLM Repair Playbook v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "summary",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "lathe.llm_repair_playbook.v1"
    },
    "status": {
      "enum": [
        "ready"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostics",
        "steps",
        "omitted"
      ],
      "properties": {
        "diagnostics": {
          "type": "integer",
          "minimum": 0
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "omitted": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repair_step"
      }
    }
  },
  "$defs": {
    "json_value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json_value"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json_value"
          }
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "column"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "repair_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "diagnostic_name",
        "diagnostic_code",
        "path",
        "instruction",
        "allowed_values",
        "example_patch"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^repair_[0-9]{3}$"
        },
        "diagnostic_name": {
          "type": "string",
          "minLength": 1
        },
        "diagnostic_code": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "source_span": {
          "$ref": "#/$defs/source_span"
        },
        "repair_hint": {
          "type": "string",
          "minLength": 1
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "allowed_values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json_value"
          }
        },
        "example_patch": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json_value"
          }
        }
      }
    }
  }
}
