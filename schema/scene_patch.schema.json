{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schema/wonder/scene-patch-v1.json",
  "title": "Lathe Wonder Scene Patch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patch_id",
    "scope",
    "target_id",
    "instruction",
    "preserve",
    "allowed_changes"
  ],
  "properties": {
    "schema_version": {
      "const": "lathe.scene_patch.v1"
    },
    "patch_id": {
      "type": "string",
      "pattern": "^patch_[a-z0-9_]{3,80}$"
    },
    "scope": {
      "enum": [
        "asset",
        "object",
        "region",
        "scene",
        "camera",
        "light",
        "curiosity_anchor",
        "hidden_state"
      ]
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,95}$"
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "preserve": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "allowed_changes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "affordances",
          "assets",
          "cameras",
          "curiosity_anchors",
          "debris",
          "geometry",
          "hidden_state",
          "layout",
          "lighting",
          "materials",
          "metadata",
          "objects",
          "props",
          "relationships",
          "scale",
          "state",
          "style",
          "transforms"
        ]
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "path"
        ],
        "properties": {
          "op": {
            "enum": [
              "add",
              "remove",
              "replace",
              "move",
              "copy",
              "test"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "from": {
            "type": "string",
            "pattern": "^/"
          },
          "value": {}
        }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "preserve_layout",
            "preserve_selected_ids",
            "branch_variant",
            "free_revision"
          ]
        },
        "preserved_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(obj|region|camera|light|curiosity|hidden)_[a-z0-9_]{3,80}$"
          }
        },
        "branch_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,79}$"
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "validators": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "spatial",
              "semantic",
              "style",
              "composition",
              "curiosity",
              "continuity",
              "export",
              "platform"
            ]
          }
        },
        "minimum_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
