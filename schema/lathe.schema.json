{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lathe.dev/schema/lathe-v0.1.normalized.json",
  "title": "Lathe v1.3.1 Normalized AST",
  "type": "object",
  "required": [
    "module",
    "imports",
    "profiles",
    "contracts",
    "critics",
    "libraries",
    "kits",
    "patterns",
    "families",
    "components",
    "assemblies",
    "traits",
    "mechanisms",
    "materials",
    "surface_programs",
    "surface_backends",
    "surface_policies",
    "decal_libraries",
    "mask_programs",
    "trim_sheets",
    "palettes",
    "reference_sets",
    "reconstruct_policies",
    "adapt_policies",
    "assembly_policies",
    "fit_profiles",
    "transfer_rules",
    "execution_profiles",
    "render_fixtures",
    "bake_profiles",
    "library_bindings",
    "material_graphs",
    "inspection_policies",
    "repair_policies",
    "fixtures",
    "tests",
    "benchmarks",
    "spaces",
    "assets",
    "variants"
  ],
  "additionalProperties": false,
  "properties": {
    "module": { "type": ["string", "null"] },
    "imports": { "type": "array", "items": { "type": "string" } },
    "profiles": { "type": "array", "items": { "$ref": "#/$defs/profile_like" } },
    "contracts": { "type": "array", "items": { "$ref": "#/$defs/profile_like" } },
    "critics": { "type": "array", "items": { "$ref": "#/$defs/critic" } },
    "libraries": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "kits": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "patterns": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "families": { "type": "array", "items": { "$ref": "#/$defs/structured_decl" } },
    "components": { "type": "array", "items": { "$ref": "#/$defs/structured_decl" } },
    "assemblies": { "type": "array", "items": { "$ref": "#/$defs/structured_decl" } },
    "traits": { "type": "array", "items": { "$ref": "#/$defs/structured_decl" } },
    "mechanisms": { "type": "array", "items": { "$ref": "#/$defs/structured_decl" } },
    "materials": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "surface_programs": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "surface_backends": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "surface_policies": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "decal_libraries": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "mask_programs": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "trim_sheets": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "palettes": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "style_packs": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "reference_sets": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "reconstruct_policies": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "adapt_policies": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "assembly_policies": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "fit_profiles": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "transfer_rules": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "execution_profiles": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "render_fixtures": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "bake_profiles": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "library_bindings": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "material_graphs": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "inspection_policies": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "repair_policies": { "type": "array", "items": { "$ref": "#/$defs/top_level_repair_policy" } },
    "fixtures": { "type": "array", "items": { "$ref": "#/$defs/mapping_decl" } },
    "tests": { "type": "array", "items": { "$ref": "#/$defs/test_like" } },
    "benchmarks": { "type": "array", "items": { "$ref": "#/$defs/test_like" } },
    "spaces": { "type": "array", "items": { "$ref": "#/$defs/space_decl" } },
    "worlds": { "type": "array", "items": { "$ref": "#/$defs/world" } },
    "scenes": { "type": "array", "items": { "$ref": "#/$defs/scene" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "variants": { "type": "array", "items": { "$ref": "#/$defs/variant" } }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "required": ["type", "value", "unit"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "unit" },
        "value": { "type": ["integer", "number"] },
        "unit": {
          "type": "string",
          "enum": ["mm", "cm", "m", "deg", "rad", "g", "kg", "ms", "s", "kb", "mb", "gb", "px", "px_per_m", "px_per_cm"]
        }
      }
    },
    "call_arg": {
      "type": "object",
      "required": ["name", "value"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": ["string", "null"] },
        "value": { "$ref": "#/$defs/expr" }
      }
    },
    "call": {
      "type": "object",
      "required": ["type", "name", "args"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "call" },
        "name": { "type": "string" },
        "args": { "type": "array", "items": { "$ref": "#/$defs/call_arg" } }
      }
    },
    "range": {
      "type": "object",
      "required": ["type", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "range" },
        "from": { "$ref": "#/$defs/expr" },
        "to": { "$ref": "#/$defs/expr" }
      }
    },
    "unary": {
      "type": "object",
      "required": ["type", "op", "value"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "unary" },
        "op": { "type": "string", "enum": ["not", "-"] },
        "value": { "$ref": "#/$defs/expr" }
      }
    },
    "binary": {
      "type": "object",
      "required": ["type", "op", "left", "right"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "binary" },
        "op": { "type": "string" },
        "left": { "$ref": "#/$defs/expr" },
        "right": { "$ref": "#/$defs/expr" }
      }
    },
    "expr": {
      "anyOf": [
        { "type": "boolean" },
        { "type": "integer" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/expr" } },
        { "$ref": "#/$defs/unit" },
        { "$ref": "#/$defs/call" },
        { "$ref": "#/$defs/range" },
        { "$ref": "#/$defs/unary" },
        { "$ref": "#/$defs/binary" }
      ]
    },
    "rule": {
      "type": "object",
      "required": ["node_type", "kind", "expr"],
      "additionalProperties": false,
      "properties": {
        "node_type": { "const": "rule" },
        "kind": { "type": "string", "enum": ["ensure", "prefer"] },
        "expr": { "$ref": "#/$defs/expr" },
        "weight": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "assert": {
      "type": "object",
      "required": ["node_type", "expr"],
      "additionalProperties": false,
      "properties": {
        "node_type": { "const": "assert" },
        "expr": { "$ref": "#/$defs/expr" }
      }
    },
    "repair_policy_spec": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "use": { "type": "string" },
        "mode": { "type": ["string", "null"] },
        "max_rounds": { "type": ["integer", "null"], "minimum": 0 },
        "allow": { "type": "array", "items": { "type": "string" } },
        "deny": { "type": "array", "items": { "type": "string" } }
      }
    },
    "top_level_repair_policy": {
      "type": "object",
      "required": ["node_type", "name", "mode", "max_rounds", "allow", "deny"],
      "additionalProperties": false,
      "properties": {
        "node_type": { "const": "repair_policy" },
        "name": { "type": "string" },
        "mode": { "type": "string" },
        "max_rounds": { "type": "integer", "minimum": 0 },
        "allow": { "type": "array", "items": { "type": "string" } },
        "deny": { "type": "array", "items": { "type": "string" } }
      }
    },
    "space_vary": {
      "type": "object",
      "required": ["path", "domain"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "domain": { "$ref": "#/$defs/expr" }
      }
    },
    "space_objective": {
      "type": "object",
      "required": ["direction", "metric"],
      "additionalProperties": false,
      "properties": {
        "direction": { "type": "string", "enum": ["maximize", "minimize"] },
        "metric": { "$ref": "#/$defs/expr" },
        "weight": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "space_spec": {
      "type": "object",
      "required": ["use", "values", "vary", "freeze", "objectives", "select"],
      "additionalProperties": false,
      "properties": {
        "use": { "type": "string" },
        "values": { "type": "object" },
        "vary": { "type": "array", "items": { "$ref": "#/$defs/space_vary" } },
        "freeze": { "type": "array", "items": { "type": "string" } },
        "objectives": { "type": "array", "items": { "$ref": "#/$defs/space_objective" } },
        "select": { "type": "object" }
      }
    },
    "space_decl": {
      "type": "object",
      "required": ["node_type", "name", "use", "values", "vary", "freeze", "objectives", "select"],
      "additionalProperties": false,
      "properties": {
        "node_type": { "const": "space" },
        "name": { "type": "string" },
        "use": { "type": "string" },
        "values": { "type": "object" },
        "vary": { "type": "array", "items": { "$ref": "#/$defs/space_vary" } },
        "freeze": { "type": "array", "items": { "type": "string" } },
        "objectives": { "type": "array", "items": { "$ref": "#/$defs/space_objective" } },
        "select": { "type": "object" }
      }
    },
    "scene_child": {
      "type": "object",
      "required": ["node_type", "name", "type", "role", "framing", "target", "from", "values"],
      "additionalProperties": false,
      "properties": {
        "node_type": {
          "type": "string",
          "enum": [
            "scene_style",
            "scene_region",
            "scene_group",
            "scene_placement_zone",
            "scene_module",
            "scene_kit",
            "scene_variant_family",
            "scene_generator",
            "scene_biome",
            "scene_scatter",
            "scene_environment",
            "scene_object",
            "scene_array",
            "scene_socket",
            "scene_attachment",
            "scene_relationship",
            "scene_camera",
            "scene_light",
            "scene_curiosity_anchor",
            "scene_hidden_state",
            "scene_export"
          ]
        },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "role": { "type": "string" },
        "framing": { "type": "string" },
        "target": { "type": "string" },
        "from": { "type": "string" },
        "values": { "type": "object" }
      }
    },
    "scene_style": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_style" } } }
      ]
    },
    "scene_region": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_region" } } }
      ]
    },
    "scene_group": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_group" } } }
      ]
    },
    "scene_placement_zone": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_placement_zone" } } }
      ]
    },
    "scene_module": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_module" } } }
      ]
    },
    "scene_kit": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_kit" } } }
      ]
    },
    "scene_variant_family": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_variant_family" } } }
      ]
    },
    "scene_generator": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_generator" } } }
      ]
    },
    "scene_biome": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_biome" } } }
      ]
    },
    "scene_scatter": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_scatter" } } }
      ]
    },
    "scene_environment": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_environment" } } }
      ]
    },
    "scene_object": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_object" } } }
      ]
    },
    "scene_array": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_array" } } }
      ]
    },
    "scene_socket": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_socket" } } }
      ]
    },
    "scene_attachment": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_attachment" } } }
      ]
    },
    "scene_relationship": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_relationship" } } }
      ]
    },
    "scene_camera": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_camera" } } }
      ]
    },
    "scene_light": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_light" } } }
      ]
    },
    "scene_curiosity_anchor": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_curiosity_anchor" } } }
      ]
    },
    "scene_hidden_state": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_hidden_state" } } }
      ]
    },
    "scene_export": {
      "allOf": [
        { "$ref": "#/$defs/scene_child" },
        { "properties": { "node_type": { "const": "scene_export" } } }
      ]
    },
    "scene": {
      "type": "object",
      "required": [
        "node_type",
        "name",
        "version",
        "brief",
        "prompt",
        "values",
        "styles",
        "regions",
        "groups",
        "placement_zones",
        "modules",
        "kits",
        "variant_families",
        "generators",
        "biomes",
        "scatters",
        "environments",
        "objects",
        "arrays",
        "sockets",
        "attachments",
        "relationships",
        "cameras",
        "lights",
        "curiosity_anchors",
        "hidden_state",
        "exports"
      ],
      "additionalProperties": false,
      "properties": {
        "node_type": { "const": "scene" },
        "name": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "brief": { "type": "string" },
        "prompt": { "type": "string" },
        "values": { "type": "object" },
        "styles": { "type": "array", "items": { "$ref": "#/$defs/scene_style" } },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/scene_region" } },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/scene_group" } },
        "placement_zones": { "type": "array", "items": { "$ref": "#/$defs/scene_placement_zone" } },
        "modules": { "type": "array", "items": { "$ref": "#/$defs/scene_module" } },
        "kits": { "type": "array", "items": { "$ref": "#/$defs/scene_kit" } },
        "variant_families": { "type": "array", "items": { "$ref": "#/$defs/scene_variant_family" } },
        "generators": { "type": "array", "items": { "$ref": "#/$defs/scene_generator" } },
        "biomes": { "type": "array", "items": { "$ref": "#/$defs/scene_biome" } },
        "scatters": { "type": "array", "items": { "$ref": "#/$defs/scene_scatter" } },
        "environments": { "type": "array", "items": { "$ref": "#/$defs/scene_environment" } },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/scene_object" } },
        "arrays": { "type": "array", "items": { "$ref": "#/$defs/scene_array" } },
        "sockets": { "type": "array", "items": { "$ref": "#/$defs/scene_socket" } },
        "attachments": { "type": "array", "items": { "$ref": "#/$defs/scene_attachment" } },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/scene_relationship" } },
        "cameras": { "type": "array", "items": { "$ref": "#/$defs/scene_camera" } },
        "lights": { "type": "array", "items": { "$ref": "#/$defs/scene_light" } },
        "curiosity_anchors": { "type": "array", "items": { "$ref": "#/$defs/scene_curiosity_anchor" } },
        "hidden_state": { "type": "array", "items": { "$ref": "#/$defs/scene_hidden_state" } },
        "exports": { "type": "array", "items": { "$ref": "#/$defs/scene_export" } }
      }
    },
    "world": {
      "type": "object",
      "required": [
        "node_type",
        "name",
        "version",
        "brief",
        "prompt",
        "values",
        "styles",
        "regions",
        "groups",
        "placement_zones",
        "modules",
        "kits",
        "variant_families",
        "generators",
        "biomes",
        "scatters",
        "environments",
        "objects",
        "arrays",
        "sockets",
        "attachments",
        "relationships",
        "cameras",
        "lights",
        "curiosity_anchors",
        "hidden_state",
        "exports"
      ],
      "additionalProperties": false,
      "properties": {
        "node_type": { "const": "world" },
        "name": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "brief": { "type": "string" },
        "prompt": { "type": "string" },
        "values": { "type": "object" },
        "styles": { "type": "array", "items": { "$ref": "#/$defs/scene_style" } },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/scene_region" } },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/scene_group" } },
        "placement_zones": { "type": "array", "items": { "$ref": "#/$defs/scene_placement_zone" } },
        "modules": { "type": "array", "items": { "$ref": "#/$defs/scene_module" } },
        "kits": { "type": "array", "items": { "$ref": "#/$defs/scene_kit" } },
        "variant_families": { "type": "array", "items": { "$ref": "#/$defs/scene_variant_family" } },
        "generators": { "type": "array", "items": { "$ref": "#/$defs/scene_generator" } },
        "biomes": { "type": "array", "items": { "$ref": "#/$defs/scene_biome" } },
        "scatters": { "type": "array", "items": { "$ref": "#/$defs/scene_scatter" } },
        "environments": { "type": "array", "items": { "$ref": "#/$defs/scene_environment" } },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/scene_object" } },
        "arrays": { "type": "array", "items": { "$ref": "#/$defs/scene_array" } },
        "sockets": { "type": "array", "items": { "$ref": "#/$defs/scene_socket" } },
        "attachments": { "type": "array", "items": { "$ref": "#/$defs/scene_attachment" } },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/scene_relationship" } },
        "cameras": { "type": "array", "items": { "$ref": "#/$defs/scene_camera" } },
        "lights": { "type": "array", "items": { "$ref": "#/$defs/scene_light" } },
        "curiosity_anchors": { "type": "array", "items": { "$ref": "#/$defs/scene_curiosity_anchor" } },
        "hidden_state": { "type": "array", "items": { "$ref": "#/$defs/scene_hidden_state" } },
        "exports": { "type": "array", "items": { "$ref": "#/$defs/scene_export" } }
      }
    },
    "profile_like": {
      "type": "object",
      "required": ["node_type", "name", "uses", "defaults", "rules", "repair"],
      "additionalProperties": true,
      "properties": {
        "node_type": { "type": "string", "enum": ["profile", "contract"] },
        "name": { "type": "string" },
        "uses": { "type": "array", "items": { "type": "string" } },
        "defaults": { "type": "object" },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
        "repair": { "$ref": "#/$defs/repair_policy_spec" }
      }
    },
    "structured_decl": {
      "type": "object",
      "required": ["node_type", "name", "kind", "uses", "defaults", "params", "geometry", "features", "surface", "assembly", "space", "repair_policy", "rules", "values"],
      "additionalProperties": false,
      "properties": {
        "node_type": { "type": "string", "enum": ["family", "component", "assembly", "trait", "mechanism"] },
        "name": { "type": "string" },
        "kind": { "type": ["string", "null"], "enum": ["hard_surface_prop", "env_module", "mechanical_assembly", null] },
        "uses": { "type": "array", "items": { "type": "string" } },
        "defaults": { "type": "object" },
        "params": { "type": "object" },
        "geometry": { "type": "object" },
        "features": { "type": "object" },
        "surface": { "type": "object" },
        "assembly": { "type": "object" },
        "space": { "$ref": "#/$defs/space_spec" },
        "repair_policy": { "$ref": "#/$defs/repair_policy_spec" },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
        "values": { "type": "object" }
      }
    },
    "mapping_decl": {
      "type": "object",
      "required": ["node_type", "name", "uses", "values"],
      "additionalProperties": false,
      "properties": {
        "node_type": { "type": "string", "enum": ["library", "kit", "pattern", "material", "surface_program", "surface_backend", "surface_policy", "decal_library", "mask_program", "trim_sheet", "palette", "style_pack", "reference_set", "reconstruct_policy", "adapt_policy", "assembly_policy", "fit_profile", "transfer_rule", "execution_profile", "render_fixture", "bake_profile", "library_binding", "material_graph", "inspection_policy", "fixture"] },
        "name": { "type": "string" },
        "uses": { "type": "array", "items": { "type": "string" } },
        "values": { "type": "object" }
      }
    },
    "weighted_item": {
      "type": "object",
      "required": ["metric", "weight"],
      "additionalProperties": false,
      "properties": {
        "metric": { "$ref": "#/$defs/expr" },
        "weight": { "type": "number", "minimum": 0 }
      }
    },
    "critic": {
      "type": "object",
      "required": ["node_type", "name", "param", "body"],
      "additionalProperties": false,
      "properties": {
        "node_type": { "const": "critic" },
        "name": { "type": "string" },
        "param": {
          "type": "object",
          "required": ["name", "type"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "type": { "const": "asset" }
          }
        },
        "body": {
          "anyOf": [
            { "$ref": "#/$defs/expr" },
            {
              "type": "object",
              "required": ["type", "items"],
              "additionalProperties": false,
              "properties": {
                "type": { "const": "weighted" },
                "items": { "type": "array", "items": { "$ref": "#/$defs/weighted_item" } }
              }
            }
          ]
        }
      }
    },
    "validate": {
      "type": "object",
      "required": ["rules", "threshold", "repair"],
      "additionalProperties": true,
      "properties": {
        "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
        "score": { "$ref": "#/$defs/expr" },
        "threshold": { "type": "number" },
        "repair": { "$ref": "#/$defs/repair_policy_spec" }
      }
    },
    "experimental_art_direction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style_tags": { "type": "array", "items": { "type": "string" } },
        "wear": { "type": "string" },
        "material_age": { "type": "string" },
        "detail_density": { "type": "string" }
      }
    },
    "experimental_references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use"],
      "properties": {
        "use": { "type": "string" },
        "_resolved_path": { "type": "string" }
      }
    },
    "experimental_kit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use"],
      "properties": {
        "use": { "type": "array", "items": { "type": "string" } }
      }
    },
    "experimental_block": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "art_direction": { "$ref": "#/$defs/experimental_art_direction" },
        "references": { "$ref": "#/$defs/experimental_references" },
        "kit": { "$ref": "#/$defs/experimental_kit" },
        "_unknown_subblocks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "asset": {
      "type": "object",
      "required": ["node_type", "name", "kind", "from", "uses", "refs", "intent", "geometry", "features", "surface", "assembly", "fit", "transfer", "reuse", "constraints", "ingest", "assembly_rules", "execution", "space", "repair_policy", "build", "validate", "package", "publish", "experimental"],
      "additionalProperties": true,
      "properties": {
        "node_type": { "const": "asset" },
        "name": { "type": "string" },
        "kind": { "type": "string", "enum": ["hard_surface_prop", "env_module", "mechanical_assembly"] },
        "from": { "type": "string" },
        "uses": { "type": "array", "items": { "type": "string" } },
        "refs": { "type": "object" },
        "intent": { "type": "object" },
        "geometry": { "type": "object" },
        "features": { "type": "object" },
        "surface": { "type": "object" },
        "assembly": { "type": "object" },
        "fit": { "type": "object" },
        "transfer": { "type": "object" },
        "reuse": { "type": "object" },
        "constraints": { "type": "object" },
        "ingest": { "type": "object" },
        "assembly_rules": { "type": "object" },
        "execution": { "type": "object" },
        "space": { "$ref": "#/$defs/space_spec" },
        "repair_policy": { "$ref": "#/$defs/repair_policy_spec" },
        "build": { "type": "object" },
        "validate": { "$ref": "#/$defs/validate" },
        "package": { "type": "object" },
        "publish": { "type": "object" },
        "experimental": { "$ref": "#/$defs/experimental_block" }
      }
    },
    "test_like": {
      "type": "object",
      "required": ["node_type", "name", "values", "asserts"],
      "additionalProperties": false,
      "properties": {
        "node_type": { "type": "string", "enum": ["test", "benchmark"] },
        "name": { "type": "string" },
        "values": { "type": "object" },
        "asserts": { "type": "array", "items": { "$ref": "#/$defs/assert" } }
      }
    },
    "patch": {
      "type": "object",
      "required": ["op", "path"],
      "additionalProperties": true,
      "properties": {
        "op": { "type": "string", "enum": ["set", "append", "remove", "unset"] },
        "path": { "type": "string" },
        "value": { "$ref": "#/$defs/expr" }
      }
    },
    "variant": {
      "type": "object",
      "required": ["node_type", "name", "on", "patches"],
      "additionalProperties": false,
      "properties": {
        "node_type": { "const": "variant" },
        "name": { "type": "string" },
        "on": { "type": "string" },
        "patches": { "type": "array", "items": { "$ref": "#/$defs/patch" } }
      }
    }
  }
}
