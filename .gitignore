dist/
dist_*/
tmp_*/
warm_*/
v05_*/
cache_probe_*/

# Parser cache (25MB, regenerates on first parse)
.lathe_lark_cache/
.lathe_lark_cache

# External vendored deps — ignored per Plan 06 amendment (custom Meta VGGT License, too large to vendor)
external/vggt/

# Editor + OS
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.DS_Store
Thumbs.db

# mkdocs rendered site
site/

# Blender scratch
*.blend1

# Env
.env
.env.local

# Node (for eventual VS Code extension workspace)
node_modules/

# Gallery render output (generated by scripts/render_gallery.py;
# HTML landing at docs/gallery/index.html is regenerated every run;
# rendered per-asset HTML, PNGs, WebPs, and build artifacts should not be committed).
docs/gallery/*/
docs/gallery/index.html

# Godot — editor cache and per-file import data, per Plan 09 Phase 2.
# The addon lives in editors/godot/lathe-addon/; demo project is examples/godot_integration_demo/.
.godot/
*.import
*.translation
export.cfg
export_presets.cfg
