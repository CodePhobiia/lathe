  ],
  "profiles": [
    {
      "node_type": "profile",
      "name": "sci_fi_env_module",
      "uses": [],
      "defaults": {
        "build": {
          "optimize": {
            "lods": 3
          }
        },
        "package": {
          "formats": [
            "usd",
            "glb"
          ],
          "manifest": true,
          "include_trace": true
        }
      },
      "rules": [
        {
          "kind": "ensure",
          "expr": {
            "type": "call",
            "name": "units",
            "args": [
              {
                "name": null,
                "value": "cm"
              }
            ]
          },
          "node_type": "rule"
        },
        {
          "kind": "ensure",
          "expr": "manifold",
          "node_type": "rule"
        },
        {
          "kind": "ensure",
          "expr": "watertight",
          "node_type": "rule"
        },
        {
          "kind": "ensure",
          "expr": {
            "type": "call",
            "name": "material_slots",
            "args": [
              {
                "name": "max",
                "value": 4
              }
            ]
          },
          "node_type": "rule"
        },
        {
          "kind": "ensure",
          "expr": {
            "type": "call",
            "name": "uv_range",
            "args": [
              {
                "name": "set",
                "value": "base"
              },
              {
                "name": "range",
                "value": {
                  "type": "range",
                  "from": 0,
                  "to": 1
                }
              }
            ]
          },
          "node_type": "rule"
        },
        {
          "kind": "ensure",
          "expr": "lightmap_uvs",
          "node_type": "rule"
        },
        {
          "kind": "ensure",
          "expr": "collision_proxy",
          "node_type": "rule"
        }
      ],
      "repair": {
        "mode": "auto_until_pass",
        "max_rounds": 3,
        "allow": [],
        "deny": []
      }
    }
  ],
  "contracts": [
    {
      "node_type": "contract",
      "name": "shipping_module",
      "uses": [
        "sci_fi_env_module"
      ],
      "defaults": {
        "build": {
          "interfaces": {
            "clearance": {
              "type": "unit",
              "value": 2,
              "unit": "cm"
            }
          }
        }
      },
      "rules": [
        {
          "kind": "ensure",
          "expr": {
            "type": "call",
            "name": "pivots",
            "args": [
              {
                "name": "policy",
                "value": "studio_standard"
              }
            ]
          },
          "node_type": "rule"
        },
        {
          "kind": "ensure",
          "expr": {
            "type": "call",
            "name": "names",
            "args": [
              {
                "name": "policy",
                "value": "studio_standard"
              }
            ]
          },
          "node_type": "rule"
        },
        {
          "kind": "ensure",
          "expr": {
            "type": "call",
            "name": "texel_density",
            "args": [
              {
                "name": "target",
                "value": {
                  "type": "unit",
                  "value": 512,
                  "unit": "px_per_m"
                }
              },
              {
                "name": "tolerance",
                "value": 0.1
              }
            ]
          },
          "node_type": "rule"
        },
        {
          "kind": "ensure",
          "expr": {
            "type": "call",
            "name": "runtime_budget",
            "args": [
              {
                "name": "draw_calls",
                "value": 3
              },
              {
                "name": "texture_memory",
                "value": {
                  "type": "unit",
                  "value": 16,
                  "unit": "mb"
                }
              }
            ]
          },
          "node_type": "rule"
        }
      ],
      "repair": {
        "mode": "auto_until_pass",
        "max_rounds": 3,
        "allow": [],
        "deny": []
      }
    }
  ],
