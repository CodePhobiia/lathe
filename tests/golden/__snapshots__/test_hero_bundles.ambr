            'Pillow',
            'openusd_text',
          ]),
          'version': '1.0.0',
        }),
        'shape': dict({
          'contract': dict({
            'inputs': dict({
              'mode_requirements': dict({
                'adapt': list([
                  'one_of(refs.meshes, refs.assets)',
                ]),
                'assemble': list([
                  'refs.assets',
                ]),
                'generate': list([
                  'intent.role',
                ]),
                'reconstruct': list([
                  'one_of(refs.images, refs.meshes)',
                ]),
              }),
              'optional': list([
                'refs.images',
                'refs.meshes',
                'refs.assets',
                'intent.parts',
                'intent.materials',
                'intent.negatives',
                'build.shape.candidates',
                'build.shape.seed',
                'build.shape.symmetry',
                'build.shape.preserve',
